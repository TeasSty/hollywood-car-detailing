---
import { Image } from "astro:assets";
import "@fontsource-variable/manrope";
import "@fontsource-variable/oswald";
import "@fontsource/yellowtail";

import Wordmark from "../components/Wordmark.astro";
import "../styles/global.css";

import keyArt from "../assets/hollywood-key-art.jpg";
import shotFront from "../assets/work/audi-a5-front-shop.jpg";
import shotHood from "../assets/work/audi-a5-hood-shop.jpg";
import shotRear from "../assets/work/audi-a5-rear-quarter.jpg";
import shotQuarter from "../assets/work/audi-a5-three-quarter.jpg";
import shotSalon from "../assets/work/salon-retrim.jpg";
import shotRings from "../assets/work/audi-rings-detail.jpg";

const siteUrl = "https://teassty.github.io/hollywood-car-detailing/";
const ogImage = `${siteUrl}og-cover.jpg`;
const phone = "+7 (951) 284-23-25";
const phoneHref = "tel:+79512842325";
const vkUrl = "https://vk.com/hollywoodcardetailing";
const address = "Ярославль, Полушкина Роща, 123";
const hours = "Пн–Сб, 10:00–20:00";

const wa = (text: string) =>
  `https://wa.me/79512842325?text=${encodeURIComponent(text)}`;

const waGeneral = wa(
  "Здравствуйте! Пишу с сайта HOLLYWOOD CAR DETAILING — хочу обсудить работы по автомобилю.",
);

const services = [
  {
    name: "Детейлинг",
    note: "Детейлинг-мойка и уборка интерьера, подготовка кузова, гидрофобные составы: керамика, жидкое стекло, антидождь.",
  },
  {
    name: "Оклейка",
    note: "Бронеплёнка прозрачная и цветная, винил, карбон. Защита кузова от сколов и смена цвета без покраски.",
  },
  {
    name: "Полировка",
    note: "Полировка кузова, а также лобового и боковых стёкол — возвращаем глубину цвета и прозрачность.",
  },
  {
    name: "Химчистка",
    note: "Химчистка салона, озонация и устранение запахов, перетяжка потолка и отдельных деталей интерьера.",
  },
  {
    name: "Свет",
    note: "Тюнинг оптики, установка Bi-LED линз, антихром масок фар и доработка штатных фонарей.",
  },
  {
    name: "Звук",
    note: "Аудиосистемы, магнитолы, сабвуферы и усилители — вплоть до автозвука соревновательного уровня.",
  },
  {
    name: "Шумоизоляция",
    note: "Шумоизоляция салона и арок: убираем лишний шум и вибрации, снижаем гул на трассе.",
  },
  {
    name: "Антикор",
    note: "Антикоррозийная обработка днища и арок — в том числе на новых автомобилях перед первой зимой.",
  },
  {
    name: "Кастом",
    note: "Обвесы, сплиттеры и спойлеры, выдвижные пороги, электротонировка и другие индивидуальные доработки.",
  },
];

const tickerItems = services.map((service) => service.name);

const cars = ["BMW F32", "Audi", "LiXiang", "Mercedes GLE", "BMW M4"];

const chips = [
  "Детейлинг",
  "Оклейка",
  "Полировка",
  "Химчистка",
  "Свет",
  "Звук",
  "Шумоизоляция",
  "Антикор",
  "Кастом",
];

const facts = [
  {
    title: "Работаем официально",
    note: "После выполнения работ студия выдаёт гарантийный заказ-наряд.",
  },
  {
    title: "Гарантия на работы",
    note: "Гарантия распространяется и на выполненные работы, и на использованные материалы.",
  },
  {
    title: "Автомобиль под присмотром",
    note: "Закрытая парковка и видеонаблюдение на территории студии.",
  },
  {
    title: "Удобная оплата",
    note: "Наличные, карта или безналичный расчёт. Запись на работы — заранее.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoDetailing",
  name: "HOLLYWOOD CAR DETAILING",
  description:
    "Детейлинг-центр в Ярославле: оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор и кастом.",
  url: siteUrl,
  image: ogImage,
  telephone: "+79512842325",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Полушкина Роща, 123",
    addressLocality: "Ярославль",
    addressCountry: "RU",
  },
  areaServed: { "@type": "City", name: "Ярославль" },
  sameAs: [vkUrl],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
      opens: "10:00",
      closes: "20:00",
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HOLLYWOOD CAR DETAILING — детейлинг-центр в Ярославле</title>
    <meta
      name="description"
      content="HOLLYWOOD CAR DETAILING — детейлинг-центр в Ярославле: оклейка бронеплёнкой и винилом, полировка, химчистка, Bi-LED свет, автозвук, шумоизоляция, антикор и кастом."
    />
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
      type="image/svg+xml"
    />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="HOLLYWOOD CAR DETAILING" />
    <meta
      property="og:title"
      content="HOLLYWOOD CAR DETAILING — детейлинг-центр в Ярославле"
    />
    <meta
      property="og:description"
      content="Оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор и кастом. Ярославль, Пн–Сб 10:00–20:00."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Фирменная графика HOLLYWOOD CAR DETAILING"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="HOLLYWOOD CAR DETAILING — детейлинг-центр в Ярославле"
    />
    <meta
      name="twitter:description"
      content="Оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор и кастом в Ярославле."
    />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    ></script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      К содержанию
    </a>

    <div class="infobar">
      <div class="shell infobar__inner">
        <p>{address}</p>
        <p>{hours}</p>
        <a href={phoneHref}>{phone}</a>
      </div>
    </div>

    <header class="topbar">
      <div class="shell topbar__inner">
        <Wordmark href="#top" />
        <nav class="topbar__nav" aria-label="Основная навигация">
          <a href="#services">Услуги</a>
          <a href="#work">Работы</a>
          <a href="#request">Заявка</a>
          <a href="#contacts">Контакты</a>
        </nav>
        <a
          class="btn btn--neon"
          href={waGeneral}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.1a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1Zm4.5-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.1-.3.2-.5 0a6.6 6.6 0 0 1-3.3-2.9c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.7.8-1 1.7-.9 2.7.3 1.4 1.1 2.6 1.4 3 .2.2 2.1 3.2 5.1 4.3 1.9.7 2.6.8 3.5.6.6-.1 1.4-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.2-.5-.3Z"></path>
          </svg>
          WhatsApp
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="shell hero__type">
          <div class="hero__lead">
            <p class="tag">Детейлинг-центр · Ярославль</p>
            <h1 class="display" id="hero-title">
              Место, где автомобиль обретает <b>новое лицо</b>
            </h1>
            <div class="hero__actions">
              <a
                class="btn btn--neon"
                href={waGeneral}
                target="_blank"
                rel="noopener noreferrer"
              >
                Написать в WhatsApp
              </a>
              <a class="btn btn--ghost" href="#request">
                Собрать заявку
              </a>
            </div>
          </div>

          <div class="hero__aside">
            <p>
              Кузов, салон, свет и звук — в одном сервисе. Объём работ
              определяем после осмотра автомобиля.
            </p>
            <dl>
              <dt>График</dt>
              <dd>{hours}</dd>
              <dt>Телефон</dt>
              <dd>
                <a href={phoneHref}>{phone}</a>
              </dd>
            </dl>
          </div>
        </div>

        <div class="hero__band">
          <Image
            src={keyArt}
            alt="Фирменная иллюстрация HOLLYWOOD CAR DETAILING: детейлинг-бокс под пальмами в ретро-голливудской стилистике"
            widths={[768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
      </section>

      <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
          <p class="ticker__group">
            {tickerItems.map((item) => (
              <span>{item}</span>
            ))}
          </p>
          <p class="ticker__group">
            {tickerItems.map((item) => (
              <span>{item}</span>
            ))}
          </p>
        </div>
      </div>

      <section class="section" id="services" aria-labelledby="services-title">
        <div class="shell">
          <div class="section__head services__head">
            <div>
              <p class="tag">Что делаем</p>
              <h2 class="display" id="services-title">
                Большой спектр работ
                <br />
                по автомобилю
              </h2>
            </div>
            <p class="lede">
              Кузов, салон, оптика и аудио — можно закрыть одной записью, не
              развозя автомобиль по разным сервисам.
            </p>
          </div>

          <ul class="services__list">
            {services.map((service) => (
              <li class="service">
                <h3 class="display">{service.name}</h3>
                <p>{service.note}</p>
              </li>
            ))}
          </ul>

          <p class="services__note">
            Стоимость зависит от автомобиля, его состояния и объёма задачи —
            актуальный прайс уточняйте в WhatsApp или по телефону.
          </p>
        </div>
      </section>

      <section
        class="section section--coal"
        id="work"
        aria-labelledby="work-title"
      >
        <div class="shell">
          <div class="section__head">
            <p class="tag">Кадры из студии</p>
            <h2 class="display" id="work-title">
              Как это выглядит вживую
            </h2>
            <p class="lede">
              Фотографии из официального профиля студии. Мы не подставляем
              стоковые кадры и не приписываем себе чужие проекты.
            </p>
          </div>

          <div class="gallery">
            <figure class="shot shot--a">
              <Image
                src={shotFront}
                alt="Audi A5 с сатиновой поверхностью кузова в цехе студии"
                widths={[400, 700, 897]}
                sizes="(max-width: 620px) 46vw, (max-width: 1080px) 46vw, 40vw"
                loading="lazy"
              />
              <figcaption>Audi A5 · сатиновая поверхность кузова</figcaption>
            </figure>

            <figure class="shot shot--b">
              <Image
                src={shotHood}
                alt="Капот Audi A5 крупным планом под светом ламп в детейлинг-боксе"
                widths={[500, 900, 1280]}
                sizes="(max-width: 620px) 46vw, (max-width: 1080px) 46vw, 56vw"
                loading="lazy"
              />
              <figcaption>Audi A5 · капот в детейлинг-боксе</figcaption>
            </figure>

            <figure class="shot shot--c">
              <Image
                src={shotRear}
                alt="Задняя часть Audi A5 Sportback: крыло, колесо и диск"
                widths={[360, 640, 960]}
                sizes="(max-width: 620px) 46vw, 30vw"
                loading="lazy"
              />
              <figcaption>Audi A5 Sportback · корма и диски</figcaption>
            </figure>

            <figure class="shot shot--d">
              <Image
                src={shotSalon}
                alt="Перетянутые стойки и потолок салона: чёрная и фиолетовая алькантара"
                widths={[360, 640, 720]}
                sizes="(max-width: 620px) 46vw, 30vw"
                loading="lazy"
              />
              <figcaption>Салон · перетяжка стоек и потолка</figcaption>
            </figure>

            <figure class="shot shot--e">
              <Image
                src={shotRings}
                alt="Эмблема Audi крупным планом на матовой поверхности крышки багажника"
                widths={[360, 640, 960]}
                sizes="(max-width: 620px) 46vw, 30vw"
                loading="lazy"
              />
              <figcaption>Кузовной элемент крупным планом</figcaption>
            </figure>

            <figure class="shot shot--f">
              <Image
                src={shotQuarter}
                alt="Audi A5 Sportback в три четверти на площадке у студии"
                widths={[640, 960]}
                sizes="100vw"
                loading="lazy"
              />
              <figcaption>Audi A5 Sportback · общий план</figcaption>
            </figure>
          </div>

          <h3 class="tag" id="cars-title" style="margin-top: 42px;">
            Автомобили, с которыми работали
          </h3>
          <ul class="cars" aria-labelledby="cars-title">
            {cars.map((car) => (
              <li>{car}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="request" aria-labelledby="request-title">
        <div class="shell">
          <div class="section__head">
            <p class="tag">Заявка за минуту</p>
            <h2 class="display" id="request-title">
              Соберите запрос сами
            </h2>
            <p class="lede">
              Отметьте нужные работы и добавьте детали — сайт соберёт готовое
              сообщение. Вы увидите его целиком и отправите в WhatsApp сами.
            </p>
          </div>

          <form class="builder" id="request-form">
            <div class="builder__pick">
              <fieldset>
                <legend>Что нужно сделать</legend>
                <div class="chips">
                  {chips.map((chip) => (
                    <label class="chip">
                      <input type="checkbox" name="task" value={chip} />
                      <span class="chip__box" aria-hidden="true" />
                      <span>{chip}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="fields">
                <div class="field">
                  <label class="field__label" for="car">
                    Марка и модель
                  </label>
                  <input
                    id="car"
                    name="car"
                    type="text"
                    autocomplete="off"
                    maxlength="80"
                    placeholder="Например, Audi A5"
                  />
                </div>
                <div class="field">
                  <label class="field__label" for="when">
                    Удобный день
                  </label>
                  <input
                    id="when"
                    name="when"
                    type="text"
                    autocomplete="off"
                    maxlength="80"
                    placeholder="Например, в субботу утром"
                  />
                </div>
                <div class="field">
                  <label class="field__label" for="detail">
                    Что важно уточнить
                  </label>
                  <input
                    id="detail"
                    name="detail"
                    type="text"
                    autocomplete="off"
                    maxlength="140"
                    placeholder="Например, есть сколы на капоте"
                  />
                </div>
              </div>
            </div>

            <div class="builder__out">
              <p class="field__label" id="preview-label">
                Готовое сообщение
              </p>
              <output
                class="builder__preview"
                id="request-preview"
                aria-live="polite"
                aria-labelledby="preview-label"
              >
                Отметьте работы слева — здесь появится текст сообщения.
              </output>
              <a
                class="btn btn--neon"
                id="request-send"
                href={waGeneral}
                target="_blank"
                rel="noopener noreferrer"
              >
                Открыть WhatsApp
              </a>
              <button class="builder__reset" type="reset">
                Очистить форму
              </button>
              <p class="note">
                Данные остаются в браузере и никуда не отправляются. Кнопка
                только открывает чат — сообщение отправляете вы.
              </p>
            </div>
          </form>

          <noscript>
            <p class="noscript-note">
              Конструктор заявки работает с JavaScript. Можно сразу{" "}
              <a href={waGeneral} target="_blank" rel="noopener noreferrer">
                написать в WhatsApp
              </a>{" "}
              или позвонить: <a href={phoneHref}>{phone}</a>.
            </p>
          </noscript>
        </div>
      </section>

      <section class="section section--coal" aria-labelledby="how-title">
        <div class="shell">
          <div class="section__head">
            <p class="tag">Как устроена работа</p>
            <h2 class="display" id="how-title">
              Без сюрпризов по ходу дела
            </h2>
          </div>
          <ul class="facts">
            {facts.map((fact) => (
              <li>
                <h3 class="display">{fact.title}</h3>
                <p>{fact.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="contacts" aria-labelledby="contacts-title">
        <div class="shell contacts__grid contacts">
          <div>
            <p class="tag">Где нас найти</p>
            <h2 class="display" id="contacts-title">
              Ярославль,
              <br />
              Полушкина Роща, 123
            </h2>
            <dl>
              <div>
                <dt>График</dt>
                <dd>{hours}</dd>
              </div>
              <div>
                <dt>Телефон</dt>
                <dd>
                  <a href={phoneHref}>{phone}</a>
                </dd>
              </div>
              <div>
                <dt>WhatsApp</dt>
                <dd>
                  <a href={waGeneral} target="_blank" rel="noopener noreferrer">
                    Написать в чат
                  </a>
                </dd>
              </div>
              <div>
                <dt>ВКонтакте</dt>
                <dd>
                  <a href={vkUrl} target="_blank" rel="noopener noreferrer">
                    vk.com/hollywoodcardetailing
                  </a>
                </dd>
              </div>
            </dl>
            <div class="contacts__actions">
              <a
                class="btn btn--neon"
                href={waGeneral}
                target="_blank"
                rel="noopener noreferrer"
              >
                Написать в WhatsApp
              </a>
              <a class="btn btn--ghost" href={phoneHref}>
                Позвонить
              </a>
            </div>
          </div>

          <aside class="contacts__aside">
            <p>
              Цены зависят от автомобиля, его состояния и объёма работ, поэтому
              мы не публикуем универсальный прайс.
            </p>
            <p>
              Напишите, что хотите сделать, — сориентируем по срокам и стоимости
              под конкретную задачу.
            </p>
          </aside>
        </div>
      </section>

      <section class="closer" aria-labelledby="closer-title">
        <div class="shell closer__inner">
          <div>
            <p class="tag">Готовы обсудить</p>
            <h2 class="display" id="closer-title">
              Покажите автомобиль —<br />
              остальное разберём на месте
            </h2>
          </div>
          <a
            class="btn btn--neon"
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
          >
            Написать в WhatsApp
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <Wordmark href="#top" />
        <p>
          {address} · {hours}
        </p>
        <p>
          <a href={vkUrl} target="_blank" rel="noopener noreferrer">
            Сообщество ВКонтакте
          </a>
        </p>
        <p>© {new Date().getFullYear()} HOLLYWOOD CAR DETAILING</p>
      </div>
    </footer>

    <script>
      const form = document.querySelector<HTMLFormElement>("#request-form");
      const preview = document.querySelector<HTMLElement>("#request-preview");
      const send = document.querySelector<HTMLAnchorElement>("#request-send");

      const empty = "Отметьте работы слева — здесь появится текст сообщения.";

      const buildMessage = () => {
        if (!form) return null;

        const data = new FormData(form);
        const tasks = data.getAll("task").map(String);
        const car = String(data.get("car") ?? "").trim();
        const when = String(data.get("when") ?? "").trim();
        const detail = String(data.get("detail") ?? "").trim();

        if (!tasks.length && !car && !when && !detail) return null;

        const lines = [
          "Здравствуйте! Пишу с сайта HOLLYWOOD CAR DETAILING.",
          "",
          `Работы: ${tasks.length ? tasks.join(", ") : "нужна консультация"}`,
          `Автомобиль: ${car || "уточню в чате"}`,
          `Удобный день: ${when || "согласуем"}`,
        ];

        if (detail) lines.push(`Детали: ${detail}`);

        return lines.join("\n");
      };

      const update = () => {
        if (!preview || !send) return;

        const message = buildMessage();
        preview.textContent = message ?? empty;
        send.href = `https://wa.me/79512842325?text=${encodeURIComponent(
          message ??
            "Здравствуйте! Пишу с сайта HOLLYWOOD CAR DETAILING — хочу обсудить работы по автомобилю.",
        )}`;
      };

      form?.addEventListener("input", update);
      form?.addEventListener("reset", () => window.setTimeout(update, 0));
      update();
    </script>
  </body>
</html>
