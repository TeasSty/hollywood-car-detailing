---
import "@fontsource-variable/manrope";
import "@fontsource-variable/unbounded";
import "../styles/global.css";

const siteUrl = "https://teassty.github.io/hollywood-car-detailing/";
const whatsappBase = "https://wa.me/79512842325";
const phoneHref = "tel:+79512842325";

const services = [
  {
    name: "Детейлинг",
    note: "Точная работа с кузовом, салоном и труднодоступными зонами.",
    mark: "Кузов + салон",
  },
  {
    name: "Оклейка",
    note: "Защитная и цветная плёнка — объём работ определяем после осмотра.",
    mark: "Защита",
  },
  {
    name: "Полировка",
    note: "Коррекция состояния поверхности и работа с визуальной глубиной цвета.",
    mark: "ЛКП",
  },
  {
    name: "Химчистка",
    note: "Последовательная очистка элементов салона с учётом материалов.",
    mark: "Салон",
  },
  {
    name: "Свет",
    note: "Работы с автомобильной оптикой и установкой современных решений.",
    mark: "Оптика",
  },
  {
    name: "Звук",
    note: "Подбор и установка компонентов автомобильной аудиосистемы.",
    mark: "Аудио",
  },
  {
    name: "Шумоизоляция",
    note: "Обработка выбранных зон автомобиля или комплексная работа.",
    mark: "Комфорт",
  },
  {
    name: "Антикор",
    note: "Защитная обработка уязвимых элементов автомобиля.",
    mark: "Защита",
  },
  {
    name: "Кастом",
    note: "Индивидуальные доработки после обсуждения задачи и автомобиля.",
    mark: "Проект",
  },
];

const cases = ["BMW F32", "Audi", "LiXiang", "Mercedes GLE", "BMW M4"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "HOLLYWOOD CAR DETAILING",
  url: siteUrl,
  telephone: "+7 951 284-23-25",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Полушкина Роща, 123",
    addressLocality: "Ярославль",
    addressCountry: "RU",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
      ],
      opens: "10:00",
      closes: "20:00",
    },
  ],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="HOLLYWOOD CAR DETAILING в Ярославле: детейлинг, оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор и кастом."
    />
    <meta name="theme-color" content="#0B0D10" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content="HOLLYWOOD CAR DETAILING — Ярославль" />
    <meta
      property="og:description"
      content="Детейлинг, после которого автомобиль хочется рассматривать."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og-cover.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="HOLLYWOOD CAR DETAILING — ночная приёмка 123" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HOLLYWOOD CAR DETAILING — Ярославль" />
    <meta
      name="twitter:description"
      content="Детейлинг, после которого автомобиль хочется рассматривать."
    />
    <meta name="twitter:image" content={`${siteUrl}og-cover.svg`} />
    <title>HOLLYWOOD CAR DETAILING — детейлинг в Ярославле</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>

    <div class="service-line" aria-label="Служебная информация">
      <div class="shell service-line__inner">
        <p>Ярославль · Полушкина Роща 123</p>
        <p>Пн–Сб · 10:00–20:00</p>
        <a href={phoneHref}>+7 (951) 284-23-25</a>
      </div>
    </div>

    <header class="site-header">
      <div class="shell nav">
        <a class="wordmark" href="#top" aria-label="HOLLYWOOD CAR DETAILING — наверх">
          <span>HOLLYWOOD</span>
          <span>CAR DETAILING</span>
        </a>
        <nav aria-label="Основная навигация">
          <a href="#inspection">Осмотр 123</a>
          <a href="#services">Услуги</a>
          <a href="#work">Работы</a>
          <a href="#contacts">Контакты</a>
        </nav>
        <a class="nav-cta" href={`${whatsappBase}?text=${encodeURIComponent("Здравствуйте! Хочу получить расчёт по детейлингу автомобиля.")}`}>
          Расчёт в WhatsApp
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="shell hero__stage">
          <div class="hero__coordinates" aria-label="Метка приёмки">
            <span>ЯР</span>
            <strong>123</strong>
            <span>57°N</span>
          </div>

          <div class="hero__copy">
            <p class="eyebrow">Ночная приёмка · Ярославль</p>
            <h1 id="hero-title">
              Детейлинг,<br />
              после которого<br />
              <em>автомобиль хочется рассматривать.</em>
            </h1>
            <div class="hero__actions">
              <a class="button button--accent" href="#inspection">Начать осмотр</a>
              <a class="text-link" href={phoneHref}>Позвонить в студию <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <p class="hero__side-note">
            Сначала смотрим на автомобиль и задачу.<br />
            Затем обсуждаем объём работ и расчёт.
          </p>

          <div class="hero-car" aria-hidden="true">
            <svg viewBox="0 0 1200 440" role="presentation">
              <g class="grid-lines">
                <path d="M40 360H1160M120 52V406M600 20V420M1080 52V406" />
                <path d="M120 88H1080M120 216H1080" />
              </g>
              <g class="measure-lines">
                <path d="M153 313h75l68-105 170-70h271l187 72 106 112h117" />
                <path d="M321 207l18 105M466 138l45 175M737 138l-31 175M924 210l-27 105" />
                <path d="M217 312c15-80 130-88 161 0M788 312c18-86 141-86 164 0" />
                <circle cx="299" cy="316" r="66" />
                <circle cx="299" cy="316" r="23" />
                <circle cx="870" cy="316" r="66" />
                <circle cx="870" cy="316" r="23" />
                <path d="M378 315H788M954 315h117M147 315h70" />
              </g>
              <g class="marker-lines">
                <circle cx="480" cy="141" r="8" />
                <path d="M480 141 416 70H308" />
                <circle cx="921" cy="214" r="8" />
                <path d="M921 214 1005 133h123" />
                <text x="311" y="61">КУЗОВ / ОСМОТР</text>
                <text x="1008" y="124">СВЕТ</text>
                <text x="101" y="388">HCD · ПРИЁМКА · 123</text>
              </g>
            </svg>
          </div>
        </div>
      </section>

      <section class="inspection" id="inspection" aria-labelledby="inspection-title">
        <div class="shell">
          <div class="section-heading inspection__heading">
            <p class="eyebrow">Интерактивная приёмка</p>
            <h2 id="inspection-title">Осмотр <span>123</span></h2>
            <p>
              Отметьте зоны и задачу. Мы соберём понятное сообщение — вы проверите его
              и отправите в WhatsApp самостоятельно.
            </p>
          </div>

          <form class="inspection-board" id="inspection-form">
            <fieldset class="zone-fieldset">
              <legend>Что нужно сделать</legend>
              <div class="zone-map">
                <svg class="zone-car" viewBox="0 0 760 360" aria-hidden="true">
                  <path class="zone-car__outline" d="M96 252h68c12-62 95-78 135 0h172c14-65 102-77 140 0h55l-6-54-73-46-89-81H282l-95 63-69 35z" />
                  <path class="zone-car__detail" d="M282 71l-67 98h350l-67-98M363 72v98M164 252h135M471 252h140M96 252l-11 25h580l-9-25" />
                  <circle class="zone-car__wheel" cx="231" cy="254" r="53" />
                  <circle class="zone-car__wheel" cx="542" cy="254" r="53" />
                  <path class="zone-car__measure" d="M80 310H680M80 296v28M680 296v28" />
                  <text x="350" y="342">ОСМОТР / 123</text>
                </svg>

                <label class="zone zone--body">
                  <input type="checkbox" name="zone" value="Кузов: полировка или детейлинг" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Кузов</strong>Полировка · детейлинг</span>
                </label>
                <label class="zone zone--film">
                  <input type="checkbox" name="zone" value="Оклейка и защита кузова" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Защита</strong>Оклейка</span>
                </label>
                <label class="zone zone--light">
                  <input type="checkbox" name="zone" value="Автомобильный свет" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Свет</strong>Оптика</span>
                </label>
                <label class="zone zone--cabin">
                  <input type="checkbox" name="zone" value="Салон: химчистка или шумоизоляция" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Салон</strong>Химчистка · тишина</span>
                </label>
                <label class="zone zone--systems">
                  <input type="checkbox" name="zone" value="Звук или кастомные доработки" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Системы</strong>Звук · кастом</span>
                </label>
                <label class="zone zone--underbody">
                  <input type="checkbox" name="zone" value="Антикоррозийная обработка" />
                  <span class="zone__pin" aria-hidden="true"></span>
                  <span class="zone__text"><strong>Низ</strong>Антикор</span>
                </label>
              </div>
            </fieldset>

            <div class="inspection-data">
              <div class="form-row">
                <label for="vehicle">Марка и модель</label>
                <input
                  id="vehicle"
                  name="vehicle"
                  type="text"
                  autocomplete="off"
                  placeholder="Например, BMW F32"
                  maxlength="80"
                />
              </div>
              <div class="form-row">
                <label for="day">Удобный день</label>
                <input
                  id="day"
                  name="day"
                  type="text"
                  autocomplete="off"
                  placeholder="Например, в пятницу"
                  maxlength="80"
                />
              </div>

              <div class="inspection-summary" aria-live="polite">
                <p class="summary-label">Резюме осмотра</p>
                <p id="inspection-summary">
                  Выберите одну или несколько зон — здесь появится ваше сообщение.
                </p>
              </div>

              <a
                class="button button--accent inspection-submit"
                id="inspection-whatsapp"
                href={`${whatsappBase}?text=${encodeURIComponent("Здравствуйте! Хочу получить расчёт в HOLLYWOOD CAR DETAILING.")}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Получить расчёт в WhatsApp
              </a>
              <p class="privacy-note">
                Данные остаются в браузере. Кнопка откроет WhatsApp; сообщение отправите только вы.
              </p>
              <button class="reset-button" type="reset">Сбросить отметки</button>
            </div>
          </form>

          <noscript>
            <p class="noscript-note">
              Интерактивный осмотр требует JavaScript. Можно сразу
              <a href={`${whatsappBase}?text=${encodeURIComponent("Здравствуйте! Хочу получить расчёт по моему автомобилю.")}`}>написать в WhatsApp</a>
              или позвонить по номеру <a href={phoneHref}>+7 (951) 284-23-25</a>.
            </p>
          </noscript>
        </div>
      </section>

      <section class="services" id="services" aria-labelledby="services-title">
        <div class="shell">
          <div class="section-heading services__heading">
            <p class="eyebrow">Работаем с автомобилем целиком</p>
            <h2 id="services-title">Не меню с ценами.<br />Карта возможностей.</h2>
            <p>
              Стоимость зависит от автомобиля, состояния и объёма задачи. Сначала осмотр —
              затем честный расчёт.
            </p>
          </div>

          <div class="service-ledger">
            {
              services.map((service) => (
                <article class="service-row">
                  <p class="service-row__mark">{service.mark}</p>
                  <h3>{service.name}</h3>
                  <p>{service.note}</p>
                  <a href="#inspection" aria-label={`Отметить задачу: ${service.name}`}>
                    В осмотр <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="case-log" id="work" aria-labelledby="work-title">
        <div class="shell case-log__grid">
          <div class="section-heading">
            <p class="eyebrow">Журнал приёмки</p>
            <h2 id="work-title">Автомобили,<br />с которыми работали.</h2>
            <p>
              Только подтверждённые модели — без стоковых кадров и приписанных результатов.
            </p>
          </div>
          <div class="case-register" role="list" aria-label="Автомобили из работ студии">
            {
              cases.map((car, index) => (
                <div class="case-register__item" role="listitem">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{car}</strong>
                  <small>зафиксирован в журнале работ</small>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="process" aria-labelledby="process-title">
        <div class="shell">
          <div class="section-heading process__heading">
            <p class="eyebrow">Как начинается работа</p>
            <h2 id="process-title">От запроса — к понятной задаче.</h2>
          </div>
          <ol class="process-line">
            <li>
              <span>1</span>
              <div><h3>Запрос</h3><p>Расскажите об автомобиле и о том, что хочется изменить.</p></div>
            </li>
            <li>
              <span>2</span>
              <div><h3>Осмотр</h3><p>Уточняем состояние, зоны работ и ожидаемый результат.</p></div>
            </li>
            <li>
              <span>3</span>
              <div><h3>Согласование</h3><p>Обсуждаем состав работ и расчёт до начала проекта.</p></div>
            </li>
            <li>
              <span>4</span>
              <div><h3>Приёмка</h3><p>Осматриваем результат вместе и закрываем согласованную задачу.</p></div>
            </li>
          </ol>
        </div>
      </section>

      <section class="proof" aria-labelledby="proof-title">
        <div class="shell proof__grid">
          <div>
            <p class="eyebrow">Без громких обещаний</p>
            <h2 id="proof-title">Автомобиль диктует объём работы.</h2>
          </div>
          <div class="proof__statement">
            <p>
              Мы не публикуем универсальную цену без осмотра: одинаковая услуга может требовать
              разного объёма подготовки на разных автомобилях.
            </p>
            <p>
              В одном месте можно обсудить внешний вид, салон, свет, звук, защиту и
              индивидуальные доработки — без вымышленных пакетов.
            </p>
          </div>
        </div>
      </section>

      <section class="contacts" id="contacts" aria-labelledby="contacts-title">
        <div class="shell contacts__layout">
          <div class="contacts__number" aria-hidden="true">123</div>
          <div class="contacts__content">
            <p class="eyebrow">Точка приёмки</p>
            <h2 id="contacts-title">Ярославль.<br />Полушкина Роща 123.</h2>
            <dl>
              <div><dt>График</dt><dd>Пн–Сб, 10:00–20:00</dd></div>
              <div><dt>Телефон</dt><dd><a href={phoneHref}>+7 (951) 284-23-25</a></dd></div>
              <div><dt>WhatsApp</dt><dd><a href={whatsappBase} target="_blank" rel="noopener noreferrer">Написать в чат</a></dd></div>
            </dl>
            <div class="contacts__actions">
              <a class="button button--accent" href="#inspection">Собрать запрос</a>
              <a class="button button--line" href={phoneHref}>Позвонить</a>
            </div>
          </div>
        </div>
      </section>

      <section class="final-cta" aria-labelledby="final-title">
        <div class="shell final-cta__inner">
          <p class="eyebrow">Если уже знаете задачу</p>
          <h2 id="final-title">Покажите автомобиль.<br />Остальное разберём на приёмке.</h2>
          <a
            class="button button--accent"
            href={`${whatsappBase}?text=${encodeURIComponent("Здравствуйте! Хочу получить расчёт по моему автомобилю.")}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Получить расчёт в WhatsApp
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <a class="wordmark" href="#top">
          <span>HOLLYWOOD</span>
          <span>CAR DETAILING</span>
        </a>
        <p>Ярославль · Полушкина Роща 123</p>
        <p>© {new Date().getFullYear()} HOLLYWOOD CAR DETAILING</p>
      </div>
    </footer>

    <script>
      const form = document.querySelector<HTMLFormElement>("#inspection-form");
      const summary = document.querySelector<HTMLElement>("#inspection-summary");
      const whatsapp = document.querySelector<HTMLAnchorElement>("#inspection-whatsapp");

      const updateInspection = () => {
        if (!form || !summary || !whatsapp) return;

        const data = new FormData(form);
        const zones = data.getAll("zone").map(String);
        const vehicle = String(data.get("vehicle") || "").trim();
        const day = String(data.get("day") || "").trim();

        const details = [
          vehicle ? `Автомобиль: ${vehicle}` : "Автомобиль: уточню в чате",
          zones.length ? `Задачи: ${zones.join("; ")}` : "Задачи: нужна консультация",
          day ? `Удобный день: ${day}` : "Удобный день: согласуем",
        ];

        summary.textContent = details.join(" · ");

        const message = [
          "Здравствуйте! Хочу получить расчёт в HOLLYWOOD CAR DETAILING.",
          "",
          ...details,
        ].join("\n");

        whatsapp.href = `https://wa.me/79512842325?text=${encodeURIComponent(message)}`;
      };

      form?.addEventListener("input", updateInspection);
      form?.addEventListener("reset", () => window.setTimeout(updateInspection, 0));
      updateInspection();
    </script>
  </body>
</html>
