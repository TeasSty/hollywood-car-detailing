---
import { Image } from "astro:assets";
import keyArt from "../assets/hollywood-key-art.jpg";
import audiFront from "../assets/work/audi-a5-front-shop.jpg";
import audiHood from "../assets/work/audi-a5-hood-shop.jpg";
import audiRear from "../assets/work/audi-a5-rear-quarter.jpg";
import audiThree from "../assets/work/audi-a5-three-quarter.jpg";
import audiRings from "../assets/work/audi-rings-detail.jpg";
import salonRetrim from "../assets/work/salon-retrim.jpg";
import "../styles/site.css";

const siteUrl = "https://teassty.github.io/hollywood-car-detailing/";
const vkUrl = "https://vk.com/hollywoodcardetailing";
const mapsUrl = "https://yandex.ru/maps/org/239649973526";
const phoneDisplay = "+7 (951) 284-23-25";
const phoneHref = "tel:+79512842325";
const waBase = "https://wa.me/79512842325";
const hours = "Пн–Сб, 10:00–20:00";
const address = "Ярославль, Ленинградский пр-т, 123Д";
const streetAddress = "Ленинградский проспект, 123Д";

const services = [
  {
    title: "Детейлинг и полировка",
    text: "Кузов доводят до чистого блеска: мойка, полировка, защита.",
  },
  {
    title: "Оклейка",
    text: "Бронеплёнка и винил — прозрачные и цветные решения под задачу.",
  },
  {
    title: "Химчистка салона",
    text: "Интерьер возвращают в рабочее состояние без «маскировки запахом».",
  },
  {
    title: "Свет",
    text: "Установка Bi-LED и работа с оптикой для ночной видимости.",
  },
  {
    title: "Звук и шумка",
    text: "Аудиосистемы и шумоизоляция — в одном боксе со студией.",
  },
  {
    title: "Антикор и кастом",
    text: "Защита днища и нестандартные доработки под конкретный автомобиль.",
  },
];

const works = [
  {
    image: audiThree,
    alt: "Audi A5 после работ в студии HOLLYWOOD CAR DETAILING",
    caption: "Audi A5 · кузов",
  },
  {
    image: audiHood,
    alt: "Капот Audi A5 крупным планом после детейлинга",
    caption: "Капот · блик",
  },
  {
    image: salonRetrim,
    alt: "Перетяжка салона автомобиля в студии",
    caption: "Салон · перетяжка",
  },
  {
    image: audiRear,
    alt: "Задняя четверть Audi A5",
    caption: "Четверть · линия",
  },
  {
    image: audiFront,
    alt: "Audi A5 в боксе студии",
    caption: "Бокс · приёмка",
  },
  {
    image: audiRings,
    alt: "Деталь эмблемы Audi крупным планом",
    caption: "Деталь · хром",
  },
];

const zones = ["Кузов", "Салон", "Оптика", "Днище", "Аудио / шумка"];
const tasks = [
  "Детейлинг",
  "Оклейка",
  "Полировка",
  "Химчистка",
  "Свет",
  "Звук",
  "Шумоизоляция",
  "Антикор",
  "Кастом",
];

const reviews = [
  {
    name: "Миля",
    text: "Приятные ребята, свою работу выполняют качественно и профессионально. Есть зона ожидания, чай, кофе. Очень интересный интерьер, не как у всех.",
  },
  {
    name: "Max",
    text: "Хорошее место, отзывчивые люди. Задержались после рабочего дня и помогли привести машину в порядок — лобовое стекло, чтобы можно было ехать ночью.",
  },
  {
    name: "Роман Тиотов",
    text: "Очень хороший коллектив. Доброжелательный, оперативно сделали полную химчистку. Советую.",
  },
];

const process = [
  {
    title: "Заявка",
    text: "Пишете в WhatsApp: автомобиль, задача, удобный день.",
  },
  {
    title: "Осмотр",
    text: "В боксе смотрим объём работ и согласуем состав до старта.",
  },
  {
    title: "Работа",
    text: "Кузов, салон, свет, звук и защита — в одном месте.",
  },
  {
    title: "Сдача",
    text: "Заказ-наряд и гарантия на работы и материалы по итогам.",
  },
];

const defaultWa = "Здравствуйте! Хочу обсудить работы по автомобилю.";
const ogPath = `${siteUrl}og-cover.jpg`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoDetailing",
  name: "HOLLYWOOD CAR DETAILING",
  url: siteUrl,
  image: ogPath,
  telephone: "+79512842325",
  address: {
    "@type": "PostalAddress",
    streetAddress,
    addressLocality: "Ярославль",
    addressCountry: "RU",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "10:00",
      closes: "20:00",
    },
  ],
  sameAs: [vkUrl, mapsUrl],
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HOLLYWOOD CAR DETAILING — детейлинг в Ярославле</title>
    <meta
      name="description"
      content="Детейлинг-центр в Ярославле: оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор и кастом. Ленинградский пр-т, 123Д."
    />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#F3EEE6" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="HOLLYWOOD CAR DETAILING" />
    <meta property="og:title" content="HOLLYWOOD CAR DETAILING — детейлинг в Ярославле" />
    <meta
      property="og:description"
      content="Место, где автомобиль обретает новое лицо. Запись в WhatsApp."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HOLLYWOOD CAR DETAILING — детейлинг в Ярославле" />
    <meta
      name="twitter:description"
      content="Детейлинг, оклейка, полировка, химчистка, свет, звук, шумоизоляция, антикор, кастом."
    />
    <meta name="twitter:image" content={ogPath} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Oranienbaum&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>

    <header class="top">
      <div class="top__bar">
        <span>{address}</span>
        <span>{hours}</span>
        <a href={phoneHref}>{phoneDisplay}</a>
      </div>
      <div class="top__nav wrap">
        <a class="mark" href="#main" aria-label="HOLLYWOOD CAR DETAILING">
          <span class="mark__h">HOLLYWOOD</span>
          <span class="mark__s">car detailing</span>
        </a>
        <nav aria-label="Разделы">
          <a href="#services">Услуги</a>
          <a href="#works">Работы</a>
          <a href="#request">Заявка</a>
          <a href="#contacts">Контакты</a>
        </nav>
        <a
          class="btn btn--solid"
          href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
          target="_blank"
          rel="noopener noreferrer">WhatsApp</a
        >
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__stage">
          <Image
            class="hero__frame"
            src={keyArt}
            alt="Фирменная обложка студии HOLLYWOOD CAR DETAILING"
            widths={[720, 1080, 1440, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            quality={82}
          />
          <div class="hero__shade" aria-hidden="true"></div>
          <div class="hero__copy wrap">
            <p class="eyebrow">Детейлинг-центр · Ярославль</p>
            <p class="hero__brand" aria-hidden="true">HOLLYWOOD</p>
            <h1 id="hero-title">Место, где автомобиль<br />обретает новое лицо</h1>
            <p class="hero__lead">
              Кузов, салон, свет и звук — в одном боксе. Объём работ согласуем после осмотра.
            </p>
            <div class="hero__cta">
              <a
                class="btn btn--solid"
                href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
                target="_blank"
                rel="noopener noreferrer">Написать в WhatsApp</a
              >
              <a class="btn btn--ghost" href="#request">Собрать заявку</a>
            </div>
          </div>
        </div>
      </section>

      <section class="strip wrap" aria-label="Быстрые факты">
        <p><strong>Бокс</strong>Закрытая парковка и видеонаблюдение</p>
        <p><strong>Оплата</strong>Наличные, карта, безнал</p>
        <p><strong>Сдача</strong>Гарантийный заказ-наряд</p>
        <p><strong>Связь</strong><a href={phoneHref}>{phoneDisplay}</a></p>
      </section>

      <section class="services wrap" id="services" aria-labelledby="services-title">
        <div class="services__head">
          <h2 id="services-title">Направления студии</h2>
          <p>Без фиксированных пакетов на сайте — состав работ собираем под конкретный автомобиль.</p>
        </div>
        <ul class="services__list">
          {
            services.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="works" id="works" aria-labelledby="works-title">
        <div class="wrap works__head">
          <h2 id="works-title">Кадры из бокса</h2>
          <p>Реальные фото из открытого профиля студии. Портфолио по кейсам пополним, когда появятся исходники.</p>
        </div>
        <div class="film" role="list">
          {
            works.map((work) => (
              <figure class="film__shot" role="listitem">
                <Image
                  src={work.image}
                  alt={work.alt}
                  widths={[320, 480, 720]}
                  sizes="(max-width: 700px) 70vw, 320px"
                  loading="lazy"
                  quality={78}
                />
                <figcaption>{work.caption}</figcaption>
              </figure>
            ))
          }
        </div>
        <div class="wrap cases">
          <p class="eyebrow">Модели в работе</p>
          <ul>
            {["BMW F32", "Audi", "LiXiang", "Mercedes GLE", "BMW M4"].map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="process wrap" aria-labelledby="process-title">
        <h2 id="process-title">Как проходит работа</h2>
        <ol class="process__list">
          {
            process.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="request wrap" id="request" aria-labelledby="request-title">
        <div class="request__intro">
          <h2 id="request-title">Собрать заявку</h2>
          <p>
            Отметьте зоны и задачи. Текст соберётся в браузере и откроется в WhatsApp — ничего не
            уходит на сервер, пока вы сами не нажмёте «Отправить» в мессенджере.
          </p>
        </div>

        <form id="builder" class="builder" novalidate>
          <fieldset>
            <legend>Зоны</legend>
            {
              zones.map((zone) => (
                <label>
                  <input type="checkbox" name="zone" value={zone} />
                  <span>{zone}</span>
                </label>
              ))
            }
          </fieldset>
          <fieldset>
            <legend>Задачи</legend>
            {
              tasks.map((task) => (
                <label>
                  <input type="checkbox" name="task" value={task} />
                  <span>{task}</span>
                </label>
              ))
            }
          </fieldset>
          <label class="field">
            <span>Марка и модель</span>
            <input name="car" type="text" maxlength="80" autocomplete="off" placeholder="Например, BMW M4" />
          </label>
          <label class="field">
            <span>Удобный день</span>
            <input name="day" type="text" maxlength="40" autocomplete="off" placeholder="Например, суббота после 14:00" />
          </label>
          <label class="field field--wide">
            <span>Комментарий</span>
            <textarea name="detail" maxlength="200" rows="3" placeholder="Что важно учесть"></textarea>
          </label>
        </form>

        <output id="preview" class="preview" for="builder" aria-live="polite"
          >Отметьте параметры — здесь появится текст сообщения.</output
        >

        <div class="request__actions">
          <a
            id="waLink"
            class="btn btn--solid"
            href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
            target="_blank"
            rel="noopener noreferrer">Открыть WhatsApp</a
          >
          <a class="btn btn--ghost" href={phoneHref}>Позвонить</a>
        </div>
      </section>

      <section class="trust wrap" aria-labelledby="trust-title">
        <div class="trust__head">
          <h2 id="trust-title">Что пишут клиенты</h2>
          <p>
            Фрагменты реальных отзывов с карточки организации.
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Источник на Яндекс Картах</a>
          </p>
        </div>
        <ul class="trust__list">
          {
            reviews.map((review) => (
              <li>
                <blockquote>
                  <p>{review.text}</p>
                  <footer>— {review.name}</footer>
                </blockquote>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="contacts wrap" id="contacts" aria-labelledby="contacts-title">
        <h2 id="contacts-title">Контакты</h2>
        <div class="contacts__grid">
          <div>
            <p class="eyebrow">Адрес</p>
            <p>{address}</p>
            <p class="muted">Ориентир: Ленинградский проспект</p>
          </div>
          <div>
            <p class="eyebrow">График</p>
            <p>{hours}</p>
          </div>
          <div>
            <p class="eyebrow">Связь</p>
            <p><a href={phoneHref}>{phoneDisplay}</a></p>
            <p>
              <a href={`${waBase}?text=${encodeURIComponent(defaultWa)}`} target="_blank" rel="noopener noreferrer"
                >WhatsApp</a
              >
            </p>
            <p>
              <a href={vkUrl} target="_blank" rel="noopener noreferrer">ВКонтакте</a>
            </p>
          </div>
        </div>
        <a
          class="btn btn--solid contacts__cta"
          href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
          target="_blank"
          rel="noopener noreferrer">Рассказать о задаче в WhatsApp</a
        >
      </section>
    </main>

    <footer class="footer wrap">
      <p>HOLLYWOOD CAR DETAILING · Ярославль</p>
      <p>{address} · {hours}</p>
      <p>
        <a href={vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
        ·
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Карта</a>
      </p>
    </footer>

    <script>
      const form = document.querySelector("#builder");
      const preview = document.querySelector("#preview");
      const waLink = document.querySelector("#waLink");
      const empty = "Отметьте параметры — здесь появится текст сообщения.";
      const fallback = "Здравствуйте! Хочу обсудить работы по автомобилю.";

      const makeMessage = (): string | null => {
        if (!(form instanceof HTMLFormElement)) return null;
        const data = new FormData(form);
        const zones = data.getAll("zone").map(String);
        const tasks = data.getAll("task").map(String);
        const car = String(data.get("car") || "").trim();
        const day = String(data.get("day") || "").trim();
        const detail = String(data.get("detail") || "").trim();
        if (!zones.length && !tasks.length && !car && !day && !detail) return null;

        const lines = [
          "Здравствуйте! Пишу с сайта HOLLYWOOD CAR DETAILING.",
          `Зоны: ${zones.length ? zones.join(", ") : "нужна консультация"}`,
          `Задачи: ${tasks.length ? tasks.join(", ") : "обсудим при осмотре"}`,
          `Автомобиль: ${car || "уточню в чате"}`,
        ];
        if (day) lines.push(`Удобный день: ${day}`);
        if (detail) lines.push(`Комментарий: ${detail}`);
        return lines.join("\n");
      };

      const update = () => {
        if (!(preview instanceof HTMLOutputElement)) return;
        if (!(waLink instanceof HTMLAnchorElement)) return;
        const message = makeMessage();
        preview.textContent = message || empty;
        waLink.href = `https://wa.me/79512842325?text=${encodeURIComponent(message || fallback)}`;
      };

      if (form instanceof HTMLFormElement) {
        form.addEventListener("input", update);
        form.addEventListener("change", update);
      }
      update();
    </script>
  </body>
</html>
