---
import { Image } from "astro:assets";
import keyArt from "../assets/hollywood-key-art.jpg";
import audiFront from "../assets/work/audi-a5-front-shop.jpg";
import audiHood from "../assets/work/audi-a5-hood-shop.jpg";
import audiRear from "../assets/work/audi-a5-rear-quarter.jpg";
import audiThree from "../assets/work/audi-a5-three-quarter.jpg";
import audiRings from "../assets/work/audi-rings-detail.jpg";
import salonRetrim from "../assets/work/salon-retrim.jpg";
import "../styles/site.css";

const siteUrl = "https://teassty.github.io/hollywood-car-detailing/";
const vkUrl = "https://vk.com/hollywoodcardetailing";
const mapsUrl = "https://yandex.ru/maps/org/hollywood_car_detailing/239649973526/";
const phoneDisplay = "+7 (951) 284-23-25";
const phoneHref = "tel:+79512842325";
const waBase = "https://wa.me/79512842325";
const tgUrl = "https://t.me/+79512842325";
const hours = "Пн–Сб 10:00–20:00";
const address = "Ярославль, Ленинградский пр-т, 123Д";
const streetAddress = "Ленинградский проспект, 123Д";
const defaultWa = "Здравствуйте! Хочу записаться в HOLLYWOOD CAR DETAILING.";
const waHref = `${waBase}?text=${encodeURIComponent(defaultWa)}`;

const services = [
  {
    title: "Полировка кузова",
    text: "Лёгкая и глубокая полировка — глубина цвета и блеск ЛКП.",
  },
  {
    title: "Оклейка бронеплёнкой",
    text: "Прозрачная или цветная защита кузова от сколов и царапин.",
  },
  {
    title: "Керамика и жидкое стекло",
    text: "Защитные покрытия кузова с гидрофобным эффектом.",
  },
  {
    title: "Bi-LED линзы и полировка фар",
    text: "Установка линз, полировка и бронирование оптики.",
  },
  {
    title: "Химчистка салона",
    text: "Глубокая чистка салона — объём и срок после осмотра.",
  },
  {
    title: "Автозвук и шумоизоляция",
    text: "От замены магнитолы до соревновательного уровня и шумоизоляции.",
  },
  {
    title: "Перетяжка салона",
    text: "Потолок, дверные карты и вставки — алькантара и аналоги.",
  },
  {
    title: "Антикор и подсветка",
    text: "Обработка днища, контурная подсветка, сигнализация и кастом.",
  },
];

const priceList = [
  { title: "Полировка кузова", price: "от 14 000 ₽" },
  { title: "Оклейка бронеплёнкой", price: "от 12 000 ₽" },
  { title: "Керамика", price: "от 18 900 ₽" },
  { title: "Жидкое стекло", price: "от 5 000 ₽" },
  { title: "Bi-LED линзы", price: "от 12 000 ₽" },
  { title: "Полировка фар", price: "от 3 500 ₽" },
  { title: "Химчистка салона", price: "уточняйте" },
  { title: "Автозвук / магнитола", price: "от 6 000 ₽" },
  { title: "Шумоизоляция", price: "от 6 000 ₽" },
  { title: "Перетяжка салона", price: "от 15 000 ₽" },
  { title: "Антикор", price: "от 20 000 ₽" },
  { title: "Контурная подсветка", price: "от 15 000 ₽" },
  { title: "Сигнализация", price: "от 11 000 ₽" },
  { title: "Кастом и допы", price: "уточняйте" },
];

const portfolio = [
  { image: audiThree, alt: "Audi A5 после работ в студии HOLLYWOOD CAR DETAILING", span: "wide" },
  { image: audiHood, alt: "Капот Audi A5 крупным планом после детейлинга", span: "tall" },
  { image: audiFront, alt: "Audi A5 в боксе студии", span: "mid" },
  { image: audiRear, alt: "Задняя четверть Audi A5", span: "mid" },
  { image: audiRings, alt: "Деталь эмблемы Audi крупным планом", span: "sq" },
  { image: salonRetrim, alt: "Чистый кожаный салон автомобиля", span: "wide" },
];

const steps = [
  { n: "01", title: "Заявка", text: "Пишете в WhatsApp или звоните: авто, задача, удобный день." },
  { n: "02", title: "Осмотр", text: "В студии смотрим объём работ и согласуем стоимость до старта." },
  { n: "03", title: "Работа", text: "Детейлинг, защита, свет, звук или кастом — всё в одном боксе." },
  { n: "04", title: "Сдача", text: "Отдаём автомобиль с гарантийным заказ-нарядом." },
];

const reviews = [
  {
    name: "Миля",
    text: "Приятные ребята, свою работу выполняют качественно и профессионально. Есть зона ожидания, чай, кофе. Очень интересный интерьер, не как у всех.",
  },
  {
    name: "Виктор Зеленцов",
    text: "Установили контурную подсветку, оклейку передней части бронеплёнкой, доводчики дверей, замену стёкол фар. Подход серьёзный — каждый проводок изолирован, уложен по заводу.",
  },
  {
    name: "Александр Самущенко",
    text: "Переделали работу за предыдущим «мастером», грамотно настроили автозвук. Позже ставил Bi-LED линзы с бронированием — аккуратно, по срокам пошли навстречу.",
  },
  {
    name: "Роман Тиотов",
    text: "Очень хороший коллектив. Доброжелательный, и оперативно по моей просьбе сделали полную химчистку. Советую! Не пожалеете.",
  },
];

const ogPath = `${siteUrl}og-cover.jpg`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: "HOLLYWOOD CAR DETAILING",
  alternateName: "Hollywood car detailing",
  description:
    "Детейлинг и тюнинг-студия в Ярославле: оклейка, полировка, химчистка, Bi-LED, автозвук, шумоизоляция, кастом.",
  url: siteUrl,
  image: ogPath,
  telephone: "+79512842325",
  address: {
    "@type": "PostalAddress",
    streetAddress,
    addressLocality: "Ярославль",
    addressRegion: "Ярославская область",
    addressCountry: "RU",
  },
  geo: { "@type": "GeoCoordinates", latitude: 57.6993, longitude: 39.7584 },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "10:00",
      closes: "20:00",
    },
  ],
  priceRange: "₽₽",
  sameAs: [vkUrl, mapsUrl, tgUrl],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "60",
    bestRating: "5",
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HOLLYWOOD CAR DETAILING — детейлинг в Ярославле</title>
    <meta
      name="description"
      content="Детейлинг-студия в Ярославле: оклейка, полировка, химчистка, Bi-LED, автозвук. Ленинградский пр-т, 123Д. Запись по телефону и WhatsApp."
    />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0B0B0C" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="HOLLYWOOD CAR DETAILING" />
    <meta property="og:title" content="HOLLYWOOD CAR DETAILING — детейлинг в Ярославле" />
    <meta
      property="og:description"
      content="Оклейка, полировка, химчистка, свет и автозвук. Ярославль, Ленинградский пр-т, 123Д."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HOLLYWOOD CAR DETAILING" />
    <meta name="twitter:description" content="Детейлинг и тюнинг в Ярославле." />
    <meta name="twitter:image" content={ogPath} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>

    <div class="topbar">
      <div class="topbar__inner">
        <a class="topbar__phone" href={phoneHref}>{phoneDisplay}</a>
        <span class="topbar__sep" aria-hidden="true">·</span>
        <span>{hours}</span>
        <span class="topbar__sep" aria-hidden="true">·</span>
        <span class="topbar__addr">{address}</span>
        <a class="topbar__wa" href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>

    <header class="site-header" data-header>
      <div class="site-header__inner">
        <a class="brand" href="#main">
          <span class="brand__mark">HOLLYWOOD</span>
          <span class="brand__sub">car detailing</span>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="sr-only">Меню</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" data-nav aria-label="Разделы">
          <a href="#services">Услуги</a>
          <a href="#prices">Цены</a>
          <a href="#works">Работы</a>
          <a href="#process">Процесс</a>
          <a href="#reviews">Отзывы</a>
          <a href="#contacts">Контакты</a>
        </nav>

        <div class="header-actions">
          <a class="header-phone" href={phoneHref}>{phoneDisplay}</a>
          <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
            >Записаться</a
          >
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__media">
          <Image
            src={keyArt}
            alt="Фирменный кадр студии HOLLYWOOD CAR DETAILING"
            widths={[960, 1280, 1600, 1920, 2560]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            quality={88}
          />
        </div>
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__content">
          <p class="hero__eyebrow">Студия детейлинга · Ярославль</p>
          <h1 id="hero-title" class="hero__title">
            <span class="hero__brand">HOLLYWOOD</span>
            <span class="hero__line">детейлинг и тюнинг</span>
          </h1>
          <p class="hero__lead">
            Оклейка, полировка, химчистка, свет и автозвук — полный уход за автомобилем в одном
            боксе на Ленинградском пр-те.
          </p>
          <div class="hero__actions">
            <a class="btn btn--solid" href={phoneHref}>Позвонить</a>
            <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener noreferrer"
              >WhatsApp</a
            >
          </div>
        </div>
      </section>

      <section class="services" id="services" aria-labelledby="services-title">
        <div class="section-head">
          <p class="kicker">Услуги</p>
          <h2 id="services-title">Что делаем в студии</h2>
          <p>
            Кузов, салон, свет, звук и защита — официально, с гарантией на услуги и материалы.
            Закрытая парковка, зона ожидания, Wi‑Fi.
          </p>
        </div>
        <ul class="services__list">
          {
            services.map((item) => (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="prices" id="prices" aria-labelledby="prices-title">
        <div class="section-head">
          <p class="kicker">Прайс</p>
          <h2 id="prices-title">Цены</h2>
          <p>
            Стартовые цены из карточки на Яндекс Картах. Точную сумму скажем после осмотра
            автомобиля.
          </p>
        </div>
        <ul class="price-list" aria-label="Прайс услуг">
          {
            priceList.map((row) => (
              <li class="price-list__row">
                <span class="price-list__name">{row.title}</span>
                <span class="price-list__sum">{row.price}</span>
              </li>
            ))
          }
        </ul>
        <div class="prices__cta">
          <p>Не нашли нужную услугу — напишите, подскажем по вашему авто.</p>
          <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
            >Уточнить в WhatsApp</a
          >
        </div>
      </section>

      <section class="portfolio" id="works" aria-labelledby="works-title">
        <div class="section-head">
          <p class="kicker">Портфолио</p>
          <h2 id="works-title">Наши работы</h2>
          <p>Реальные кадры из бокса HOLLYWOOD CAR DETAILING.</p>
        </div>
        <div class="portfolio__masonry">
          {
            portfolio.map((shot) => (
              <figure class={`shot shot--${shot.span}`}>
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={[480, 720, 960, 1280, 1600]}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 40vw"
                  loading="lazy"
                  quality={86}
                />
              </figure>
            ))
          }
        </div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="section-head">
          <p class="kicker">Процесс</p>
          <h2 id="process-title">Как мы работаем</h2>
          <p>Четыре шага от сообщения до сдачи автомобиля.</p>
        </div>
        <ol class="process__list">
          {
            steps.map((step) => (
              <li>
                <span class="process__n" aria-hidden="true">
                  {step.n}
                </span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="reviews" id="reviews" aria-labelledby="reviews-title">
        <div class="section-head">
          <p class="kicker">Отзывы</p>
          <h2 id="reviews-title">Что говорят клиенты</h2>
          <p>
            С{" "}
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Яндекс Карт</a>. Рейтинг
            5.0 · Good Place 2026.
          </p>
        </div>
        <ul class="reviews__grid">
          {
            reviews.map((r) => (
              <li>
                <blockquote>
                  <p>{r.text}</p>
                  <footer>— {r.name}</footer>
                </blockquote>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="contacts" id="contacts" aria-labelledby="contacts-title">
        <div class="contacts__grid">
          <div class="contacts__copy">
            <p class="kicker">Контакты</p>
            <h2 id="contacts-title">Приезжайте или запишитесь онлайн</h2>
            <dl class="contacts__facts">
              <div>
                <dt>Адрес</dt>
                <dd>
                  <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{address}</a>
                </dd>
              </div>
              <div>
                <dt>График</dt>
                <dd>{hours}<br />Воскресенье — выходной</dd>
              </div>
              <div>
                <dt>Телефон</dt>
                <dd><a href={phoneHref}>{phoneDisplay}</a></dd>
              </div>
              <div>
                <dt>Мессенджеры</dt>
                <dd class="contacts__links">
                  <a href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
                  <a href={tgUrl} target="_blank" rel="noopener noreferrer">Telegram</a>
                  <a href={vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
                </dd>
              </div>
            </dl>
            <div class="contacts__actions">
              <a class="btn btn--solid" href={phoneHref}>Позвонить</a>
              <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener noreferrer"
                >WhatsApp</a
              >
            </div>
          </div>
          <div class="contacts__map">
            <iframe
              title="Карта: HOLLYWOOD CAR DETAILING на Яндекс Картах"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src="https://yandex.ru/map-widget/v1/?ol=biz&oid=239649973526&z=16&ll=39.7584%2C57.6993"
            ></iframe>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="brand brand--footer">
          <span class="brand__mark">HOLLYWOOD</span>
          <span class="brand__sub">car detailing</span>
        </p>
        <p>{address}</p>
        <p>
          <a href={phoneHref}>{phoneDisplay}</a>
          ·
          <a href={vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
          ·
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Карта</a>
        </p>
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const toggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-nav]");
      if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("is-open", open);
          document.body.classList.toggle("nav-open", open);
        };
        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });
      }

      const header = document.querySelector("[data-header]");
      const onHeaderScroll = () => {
        if (!(header instanceof HTMLElement)) return;
        header.classList.toggle("is-scrolled", window.scrollY > 12);
      };
      onHeaderScroll();
      window.addEventListener("scroll", onHeaderScroll, { passive: true });

      if (!reduceMotion && "IntersectionObserver" in window) {
        const targets = document.querySelectorAll(
          ".section-head, .services__list li, .price-list__row, .shot, .process__list li, .reviews__grid li",
        );
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -4% 0px" },
        );
        targets.forEach((el, i) => {
          el.classList.add("will-in");
          if (el instanceof HTMLElement) el.style.setProperty("--d", `${(i % 6) * 50}ms`);
          io.observe(el);
        });
        window.setTimeout(() => {
          targets.forEach((el) => el.classList.add("is-in"));
        }, 1800);
      }
    </script>
  </body>
</html>
