---
import { Image } from "astro:assets";
import keyArt from "../assets/hollywood-key-art.jpg";
import audiFront from "../assets/work/audi-a5-front-shop.jpg";
import audiHood from "../assets/work/audi-a5-hood-shop.jpg";
import audiRear from "../assets/work/audi-a5-rear-quarter.jpg";
import audiThree from "../assets/work/audi-a5-three-quarter.jpg";
import audiRings from "../assets/work/audi-rings-detail.jpg";
import salonRetrim from "../assets/work/salon-retrim.jpg";
import "../styles/site.css";

const siteUrl = "https://teassty.github.io/hollywood-car-detailing/";
const vkUrl = "https://vk.com/hollywoodcardetailing";
const mapsUrl = "https://yandex.ru/maps/org/hollywood_car_detailing/239649973526/";
const phoneDisplay = "+7 (951) 284-23-25";
const phoneHref = "tel:+79512842325";
const waBase = "https://wa.me/79512842325";
const tgUrl = "https://t.me/+79512842325";
const hours = "Пн–Сб · 10:00–20:00";
const address = "Ярославль, Ленинградский проспект, 123Д";
const streetAddress = "Ленинградский проспект, 123Д";
const defaultWa = "Здравствуйте! Хочу записаться в HOLLYWOOD CAR DETAILING.";

const departments = [
  {
    id: "skin",
    title: "Skin",
    ru: "Кузов",
    text: "Оклейка бронеплёнкой и винилом, антихром, полировка, керамика, жидкое стекло, антидождь.",
  },
  {
    id: "light",
    title: "Light",
    ru: "Свет",
    text: "Bi-LED линзы, ремонт и полировка фар, бронирование оптики.",
  },
  {
    id: "sound",
    title: "Sound",
    ru: "Звук",
    text: "Аудиосистемы от штатной замены до соревновательного уровня, магнитолы, шумоизоляция.",
  },
  {
    id: "interior",
    title: "Interior",
    ru: "Салон",
    text: "Химчистка, перетяжка потолка и деталей, контурная подсветка, звездное небо.",
  },
  {
    id: "care",
    title: "Care",
    ru: "Уход",
    text: "Детейлинг-мойка, детейлинг-уборка, антикор, предпродажная подготовка.",
  },
  {
    id: "custom",
    title: "Custom",
    ru: "Кастом",
    text: "Обвесы, доводчики, электротонировка, сигнализации и нестандартные установки.",
  },
];

const takes = [
  {
    image: audiThree,
    alt: "Audi A5 после работ в студии HOLLYWOOD CAR DETAILING",
    label: "Кузов",
  },
  {
    image: salonRetrim,
    alt: "Перетяжка салона автомобиля в студии",
    label: "Салон",
  },
  {
    image: audiHood,
    alt: "Капот Audi A5 крупным планом после детейлинга",
    label: "Блик",
  },
  {
    image: audiFront,
    alt: "Audi A5 в боксе студии",
    label: "Бокс",
  },
  {
    image: audiRear,
    alt: "Задняя четверть Audi A5",
    label: "Линия",
  },
  {
    image: audiRings,
    alt: "Деталь эмблемы Audi крупным планом",
    label: "Деталь",
  },
];

const steps = [
  {
    title: "Заявка",
    text: "Пишете в WhatsApp или Telegram: авто, задача, удобный день.",
  },
  {
    title: "Осмотр",
    text: "В студии смотрим объём и согласуем работы до старта.",
  },
  {
    title: "Работа",
    text: "Кузов, салон, свет, звук и защита — в одном месте.",
  },
  {
    title: "Сдача",
    text: "Отдаём авто с гарантийным заказ-нарядом.",
  },
];

const reviews = [
  {
    name: "Миля",
    text: "Приятные ребята, свою работу выполняют качественно и профессионально. Есть зона ожидания, чай, кофе. Очень интересный интерьер, не как у всех.",
  },
  {
    name: "Виктор Зеленцов",
    text: "Установили контурную подсветку, оклейку передней части бронеплёнкой, доводчики дверей, замену стёкол фар. Подход серьёзный — каждый проводок изолирован, уложен по заводу.",
  },
  {
    name: "Александр Самущенко",
    text: "Переделали работу за предыдущим «мастером», грамотно настроили автозвук. Позже ставил Bi-LED линзы с бронированием — аккуратно, по срокам пошли навстречу.",
  },
];

const buildOptions = [
  "Оклейка / плёнка",
  "Полировка",
  "Химчистка",
  "Bi-LED / свет",
  "Автозвук",
  "Шумоизоляция",
  "Перетяжка салона",
  "Антихром",
  "Антикор",
  "Кастом",
];

const ogPath = `${siteUrl}og-cover.jpg`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: "HOLLYWOOD CAR DETAILING",
  alternateName: "Hollywood car detailing",
  description:
    "Детейлинг и тюнинг-студия в Ярославле: оклейка, полировка, химчистка, Bi-LED, автозвук, шумоизоляция, кастом.",
  url: siteUrl,
  image: ogPath,
  telephone: "+79512842325",
  address: {
    "@type": "PostalAddress",
    streetAddress,
    addressLocality: "Ярославль",
    addressRegion: "Ярославская область",
    addressCountry: "RU",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 57.6993,
    longitude: 39.7584,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "10:00",
      closes: "20:00",
    },
  ],
  priceRange: "₽₽",
  sameAs: [vkUrl, mapsUrl, tgUrl],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "60",
    bestRating: "5",
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HOLLYWOOD CAR DETAILING — студия полного образа авто в Ярославле</title>
    <meta
      name="description"
      content="Детейлинг, оклейка, Bi-LED, автозвук, шумоизоляция и кастом в Ярославле. Ленинградский пр-т, 123Д. Запись в WhatsApp."
    />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0A0A0B" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="HOLLYWOOD CAR DETAILING" />
    <meta
      property="og:title"
      content="HOLLYWOOD CAR DETAILING — студия полного образа авто"
    />
    <meta
      property="og:description"
      content="Свет, звук, защита и салон — в одном боксе. Ярославль, Ленинградский пр-т, 123Д."
    />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogPath} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="HOLLYWOOD CAR DETAILING" />
    <meta
      name="twitter:description"
      content="Студия полного образа автомобиля в Ярославле."
    />
    <meta name="twitter:image" content={ogPath} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">К содержанию</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="#main">
          <span class="brand__mark">HOLLYWOOD</span>
          <span class="brand__sub">car detailing</span>
        </a>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="sr-only">Меню</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>

        <nav class="site-nav" id="site-nav" data-nav aria-label="Разделы">
          <a href="#departments">Студия</a>
          <a href="#takes">Работы</a>
          <a href="#build">Заявка</a>
          <a href="#visit">Визит</a>
        </nav>

        <a
          class="btn btn--red header-cta"
          href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
          target="_blank"
          rel="noopener noreferrer">Записать авто</a
        >
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__media">
          <Image
            src={keyArt}
            alt="Фирменный кадр студии HOLLYWOOD CAR DETAILING"
            widths={[720, 1080, 1440, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            quality={82}
          />
          <div class="hero__veil" aria-hidden="true"></div>
        </div>
        <div class="hero__copy">
          <p class="hero__brand" id="hero-title">HOLLYWOOD</p>
          <p class="hero__tag">Детейлинг и тюнинг в Ярославле</p>
          <p class="hero__lead">
            Оклейка, полировка, химчистка, свет и автозвук — в одной студии.
          </p>
          <div class="hero__actions">
            <a
              class="btn btn--red"
              href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
              target="_blank"
              rel="noopener noreferrer">Записать авто</a
            >
            <a class="btn btn--ghost" href="#build">Оставить заявку</a>
          </div>
        </div>
        <p class="hero__meta">
          <a href={phoneHref}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{hours}</span>
        </p>
      </section>

      <section class="departments" id="departments" aria-labelledby="dept-title">
        <div class="section-head">
          <h2 id="dept-title">Услуги</h2>
          <p>Можно сделать одну работу или несколько сразу.</p>
        </div>
        <ul class="dept-grid">
          {
            departments.map((d) => (
              <li class="dept" id={d.id}>
                <p class="dept__en">{d.title}</p>
                <h3 class="dept__ru">{d.ru}</h3>
                <p class="dept__text">{d.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="takes" id="takes" aria-labelledby="takes-title">
        <div class="section-head">
          <h2 id="takes-title">Работы</h2>
          <p>Фото из профиля студии.</p>
        </div>
        <div class="takes__grid">
          {
            takes.map((take) => (
              <figure class="take">
                <Image
                  src={take.image}
                  alt={take.alt}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 700px) 100vw, 33vw"
                  loading="lazy"
                  quality={78}
                />
                <figcaption>{take.label}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section class="process" id="process" aria-labelledby="process-title">
        <div class="section-head">
          <h2 id="process-title">Как мы работаем</h2>
          <p>От сообщения до сдачи автомобиля.</p>
        </div>
        <ol class="process__list">
          {
            steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="voices" id="voices" aria-labelledby="voices-title">
        <div class="section-head">
          <h2 id="voices-title">Отзывы</h2>
          <p>
            С{" "}
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Яндекс Карт</a>
            {" "}и карточки организации. Рейтинг 5.0 · Good Place 2026.
          </p>
        </div>
        <ul class="voices__list">
          {
            reviews.map((r) => (
              <li>
                <blockquote>
                  <p>{r.text}</p>
                  <footer>— {r.name}</footer>
                </blockquote>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="build" id="build" aria-labelledby="build-title">
        <div class="build__intro">
          <h2 id="build-title">Заявка</h2>
          <p>Выберите услуги и нажмите WhatsApp — откроется готовое сообщение.</p>
        </div>

        <form id="builder" class="builder" novalidate>
          <fieldset>
            <legend>Услуги</legend>
            {
              buildOptions.map((item) => (
                <label class="chip">
                  <input type="checkbox" name="dept" value={item} />
                  <span>{item}</span>
                </label>
              ))
            }
          </fieldset>
          <label class="field">
            <span>Марка и модель</span>
            <input
              name="car"
              type="text"
              maxlength="80"
              autocomplete="off"
              placeholder="Например, Audi A5"
            />
          </label>
          <label class="field">
            <span>Удобный день</span>
            <input
              name="day"
              type="text"
              maxlength="40"
              autocomplete="off"
              placeholder="Суббота после 14:00"
            />
          </label>
          <label class="field field--wide">
            <span>Комментарий</span>
            <textarea
              name="detail"
              maxlength="240"
              rows="3"
              placeholder="Что важно учесть"></textarea>
          </label>
        </form>

        <output id="preview" class="preview" for="builder" aria-live="polite"
          >Выберите услуги — здесь появится текст для WhatsApp.</output
        >

        <div class="build__actions">
          <a
            id="waLink"
            class="btn btn--red"
            href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
            target="_blank"
            rel="noopener noreferrer">Открыть WhatsApp</a
          >
          <a class="btn btn--ghost" href={tgUrl} target="_blank" rel="noopener noreferrer"
            >Telegram</a
          >
          <a class="btn btn--ghost" href={phoneHref}>Позвонить</a>
        </div>
      </section>

      <section class="visit" id="visit" aria-labelledby="visit-title">
        <div class="visit__copy">
          <h2 id="visit-title">Визит</h2>
          <dl class="visit__facts">
            <div>
              <dt>Адрес</dt>
              <dd>
                <a href={mapsUrl} target="_blank" rel="noopener noreferrer">{address}</a>
              </dd>
            </div>
            <div>
              <dt>График</dt>
              <dd>{hours}<br />Воскресенье — выходной</dd>
            </div>
            <div>
              <dt>Связь</dt>
              <dd>
                <a href={phoneHref}>{phoneDisplay}</a><br />
                <a href={`${waBase}?text=${encodeURIComponent(defaultWa)}`} target="_blank" rel="noopener noreferrer"
                  >WhatsApp</a
                >
                ·
                <a href={tgUrl} target="_blank" rel="noopener noreferrer">Telegram</a>
                ·
                <a href={vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
              </dd>
            </div>
            <div>
              <dt>На месте</dt>
              <dd>Закрытая парковка, видеонаблюдение, зона ожидания, Wi‑Fi. Оплата: наличные, карта, безнал.</dd>
            </div>
          </dl>
          <a
            class="btn btn--red"
            href={`${waBase}?text=${encodeURIComponent(defaultWa)}`}
            target="_blank"
            rel="noopener noreferrer">Записать авто</a
          >
        </div>
        <div class="visit__map">
          <iframe
            title="Карта: HOLLYWOOD CAR DETAILING на Яндекс Картах"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src="https://yandex.ru/map-widget/v1/?ol=biz&oid=239649973526&z=16&ll=39.7584%2C57.6993"
          ></iframe>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="brand brand--footer">
          <span class="brand__mark">HOLLYWOOD</span>
          <span class="brand__sub">car detailing</span>
        </p>
        <p>{address}</p>
        <p>
          <a href={phoneHref}>{phoneDisplay}</a>
          ·
          <a href={vkUrl} target="_blank" rel="noopener noreferrer">VK</a>
          ·
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Карта</a>
        </p>
      </div>
    </footer>

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* Mobile nav */
      const toggle = document.querySelector("[data-nav-toggle]");
      const nav = document.querySelector("[data-nav]");
      if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("is-open", open);
          document.body.classList.toggle("nav-open", open);
        };
        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });
        nav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setOpen(false));
        });
      }

      /* Scroll reveals */
      if (!reduceMotion && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        document
          .querySelectorAll(".dept, .take, .process__list li, .voices__list li, .section-head")
          .forEach((el) => {
            el.classList.add("will-in");
            io.observe(el);
          });
      }

      /* Заявка → WhatsApp */
      const form = document.querySelector("#builder");
      const preview = document.querySelector("#preview");
      const waLink = document.querySelector("#waLink");
      const empty = "Выберите услуги — здесь появится текст для WhatsApp.";
      const fallback = "Здравствуйте! Хочу записаться в HOLLYWOOD CAR DETAILING.";

      const makeMessage = (): string | null => {
        if (!(form instanceof HTMLFormElement)) return null;
        const data = new FormData(form);
        const depts = data.getAll("dept").map(String);
        const car = String(data.get("car") || "").trim();
        const day = String(data.get("day") || "").trim();
        const detail = String(data.get("detail") || "").trim();
        if (!depts.length && !car && !day && !detail) return null;

        const lines = [
          "Здравствуйте! Пишу с сайта HOLLYWOOD CAR DETAILING.",
          `Услуги: ${depts.length ? depts.join(", ") : "нужна консультация"}`,
          `Автомобиль: ${car || "уточню в чате"}`,
        ];
        if (day) lines.push(`Удобный день: ${day}`);
        if (detail) lines.push(`Комментарий: ${detail}`);
        return lines.join("\n");
      };

      const update = () => {
        if (!(preview instanceof HTMLOutputElement)) return;
        if (!(waLink instanceof HTMLAnchorElement)) return;
        const message = makeMessage();
        preview.textContent = message || empty;
        waLink.href = `https://wa.me/79512842325?text=${encodeURIComponent(message || fallback)}`;
      };

      if (form instanceof HTMLFormElement) {
        form.addEventListener("input", update);
        form.addEventListener("change", update);
      }
      update();
    </script>
  </body>
</html>
