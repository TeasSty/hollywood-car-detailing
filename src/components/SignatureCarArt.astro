---
/**
 * White line-art sedan (¾ front view) for the signature section.
 * Stroke-only technical drawing — not a photo or 3D model.
 */
---

<svg
  class="signature__car"
  viewBox="0 0 900 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  data-sig-car
>
  <g class="signature__car-strokes" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Ground shadow ellipse -->
    <ellipse cx="455" cy="438" rx="290" ry="18" stroke-width="1" opacity="0.35" />

    <!-- Main body silhouette (¾ front, facing left) -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.35"
      d="M168 318
         C175 292 198 268 235 252
         L278 238
         C310 228 348 218 392 208
         L458 196
         C520 186 575 182 628 190
         L688 204
         C722 214 748 232 762 258
         L778 292
         C786 312 788 328 784 348
         L776 372
         C768 392 748 404 722 408
         L640 418
         L548 424
         L420 428
         L312 422
         L248 408
         C210 396 182 368 168 338 Z"
    />

    <!-- Hood plane -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.1"
      d="M248 268
         L292 252
         C340 236 395 224 448 216
         L520 208
         C560 206 598 210 632 220
         L668 234
         L652 268
         C620 256 580 248 538 246
         L470 250
         C410 256 348 268 298 286
         L248 268 Z"
    />

    <!-- Hood character lines -->
    <path class="signature__stroke-draw" stroke-width="0.85" opacity="0.85" d="M300 272 L380 248 L470 238 L560 236" />
    <path class="signature__stroke-draw" stroke-width="0.75" opacity="0.7" d="M320 286 L400 262 L490 252 L575 250" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.55" d="M340 298 L415 278 L505 268" />

    <!-- A-pillar + windshield -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.15"
      d="M392 208
         L428 152
         C448 128 478 116 512 114
         L598 118
         C628 120 650 132 662 152
         L678 190
         L628 190
         L520 186
         L458 196 Z"
    />
    <path class="signature__stroke-draw" stroke-width="0.8" opacity="0.75" d="M440 168 L520 148 L600 150 L640 172" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.55" d="M455 188 L530 170 L605 174" />

    <!-- Roof -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.2"
      d="M512 114
         L598 118
         C640 122 678 138 702 168
         L718 198
         L688 204
         L628 190
         L598 118 Z"
    />
    <path class="signature__stroke-draw" stroke-width="0.75" opacity="0.65" d="M530 128 L600 132 L660 152 L690 182" />

    <!-- Side glass / B-pillar -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.05"
      d="M662 152
         L702 168
         L718 198
         L728 248
         L718 292
         L688 304
         L668 268
         L678 190 Z"
    />
    <path class="signature__stroke-draw" stroke-width="0.8" opacity="0.7" d="M678 178 L708 196 L718 250 L708 286" />

    <!-- Front bumper + grille zone -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.2"
      d="M168 318
         C172 340 188 362 218 378
         L268 396
         L312 408
         L248 408
         C210 396 182 368 168 338 Z"
    />
    <path
      class="signature__stroke-draw"
      stroke-width="0.95"
      d="M198 332
         C210 348 232 360 262 368
         L300 376
         L278 392
         L230 372
         C208 360 192 344 186 328 Z"
    />
    <!-- Kidney grille suggestion -->
    <path class="signature__stroke-draw" stroke-width="0.9" d="M218 340 L248 352 L272 358 L258 370 L228 358 L210 346 Z" />
    <path class="signature__stroke-draw" stroke-width="0.65" opacity="0.7" d="M228 348 L250 358 L262 362" />
    <path class="signature__stroke-draw" stroke-width="0.65" opacity="0.7" d="M222 354 L244 364 L256 368" />

    <!-- Headlight (left/near) -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.1"
      d="M236 292
         C252 278 278 272 302 276
         L318 284
         C300 298 272 308 248 312
         C238 308 232 300 236 292 Z"
    />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.75" d="M250 290 L288 282 L304 286" />

    <!-- Headlight (far side hint) -->
    <path
      class="signature__stroke-draw"
      stroke-width="0.85"
      opacity="0.8"
      d="M318 268
         C332 258 352 256 368 262
         L376 270
         C360 278 340 280 324 276 Z"
    />

    <!-- Front fender crease -->
    <path class="signature__stroke-draw" stroke-width="0.9" d="M248 312 C280 300 320 292 358 290 L390 296" />
    <path class="signature__stroke-draw" stroke-width="0.8" opacity="0.7" d="M268 340 C310 328 360 320 410 322" />

    <!-- Door line + handle -->
    <path class="signature__stroke-draw" stroke-width="1" d="M420 250 L428 318 L438 392 L420 424" />
    <path class="signature__stroke-draw" stroke-width="0.85" d="M520 242 L528 310 L536 390 L520 422" />
    <path class="signature__stroke-draw" stroke-width="0.9" d="M428 318 L528 310 L620 302 L688 304" />
    <path class="signature__stroke-draw" stroke-width="0.75" d="M548 328 L572 326" />
    <rect x="548" y="322" width="28" height="8" rx="2" stroke-width="0.75" />

    <!-- Side skirt character line -->
    <path class="signature__stroke-draw" stroke-width="0.95" d="M312 408 L420 420 L548 424 L640 418 L722 408" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.65" d="M340 398 L450 410 L560 414 L680 402" />

    <!-- Rear quarter + trunk -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.05"
      d="M702 168
         L740 210
         C758 232 768 258 770 286
         L772 330
         L776 372
         L722 408
         L718 292
         L728 248
         L718 198 Z"
    />
    <path class="signature__stroke-draw" stroke-width="0.8" opacity="0.75" d="M720 220 L748 248 L760 290 L762 340" />
    <path class="signature__stroke-draw" stroke-width="0.85" d="M688 304 L720 300 L752 312 L762 348" />

    <!-- Front wheel arch + wheel -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.25"
      d="M262 396
         C262 352 298 318 342 318
         C386 318 418 352 418 396
         C418 420 398 428 342 428
         C290 428 262 418 262 396 Z"
    />
    <circle class="signature__stroke-draw" cx="340" cy="392" r="48" stroke-width="1.15" />
    <circle class="signature__stroke-draw" cx="340" cy="392" r="28" stroke-width="0.9" />
    <circle class="signature__stroke-draw" cx="340" cy="392" r="10" stroke-width="0.85" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.8" d="M340 364 L340 420 M312 392 L368 392 M320 372 L360 412 M320 412 L360 372" />

    <!-- Rear wheel arch + wheel -->
    <path
      class="signature__stroke-draw"
      stroke-width="1.25"
      d="M612 408
         C612 364 648 330 692 330
         C736 330 768 364 768 408
         C768 428 748 436 692 436
         C640 436 612 426 612 408 Z"
    />
    <circle class="signature__stroke-draw" cx="690" cy="404" r="46" stroke-width="1.15" />
    <circle class="signature__stroke-draw" cx="690" cy="404" r="26" stroke-width="0.9" />
    <circle class="signature__stroke-draw" cx="690" cy="404" r="9" stroke-width="0.85" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.8" d="M690 378 L690 430 M664 404 L716 404 M672 386 L708 422 M672 422 L708 386" />

    <!-- Mirror -->
    <path
      class="signature__stroke-draw"
      stroke-width="0.95"
      d="M648 228
         L678 218
         C688 216 694 222 692 232
         L686 248
         C682 254 674 254 668 250
         L648 240 Z"
    />

    <!-- Lower front splitter detail -->
    <path class="signature__stroke-draw" stroke-width="0.8" opacity="0.75" d="M218 378 L268 396 L300 404" />
    <path class="signature__stroke-draw" stroke-width="0.7" opacity="0.55" d="M200 350 L230 366 L270 380" />
  </g>
</svg>
