---
import SignatureCarArt from "./SignatureCarArt.astro";

interface PriceRow {
  id: string;
  title: string;
  price: string;
}

interface Props {
  prices: PriceRow[];
  waHref: string;
}

const { prices, waHref } = Astro.props;

/** Real Hollywood services — titles + short subtitles for callouts */
const zones = [
  {
    id: "optics",
    title: "Bi-LED линзы",
    subtitle: "полировка фар от 3 500 ₽",
    price: "от 12 000 ₽",
    priceIds: ["price-biled", "price-headlights"],
    ax: 28.5,
    ay: 58,
    lx: 6,
    ly: 72,
    side: "left" as const,
  },
  {
    id: "ppf",
    title: "Бронеплёнка",
    subtitle: "защита от сколов",
    price: "от 12 000 ₽",
    priceIds: ["price-ppf"],
    ax: 42,
    ay: 42,
    lx: 8,
    ly: 18,
    side: "left" as const,
  },
  {
    id: "paint",
    title: "Полировка кузова",
    subtitle: "глубокий блеск ЛКП",
    price: "от 14 000 ₽",
    priceIds: ["price-polish"],
    ax: 54,
    ay: 30,
    lx: 38,
    ly: 6,
    side: "top" as const,
  },
  {
    id: "interior",
    title: "Химчистка салона",
    subtitle: "чистота внутри",
    price: "уточняйте",
    priceIds: ["price-interior"],
    ax: 62,
    ay: 48,
    lx: 78,
    ly: 8,
    side: "right" as const,
  },
  {
    id: "ceramic",
    title: "Керамика",
    subtitle: "жидкое стекло от 5 000 ₽",
    price: "от 18 900 ₽",
    priceIds: ["price-ceramic", "price-glasscoat"],
    ax: 78,
    ay: 46,
    lx: 92,
    ly: 28,
    side: "right" as const,
  },
  {
    id: "audio",
    title: "Автозвук",
    subtitle: "магнитола и акустика",
    price: "от 6 000 ₽",
    priceIds: ["price-audio"],
    ax: 56,
    ay: 68,
    lx: 48,
    ly: 92,
    side: "bottom" as const,
  },
  {
    id: "anticor",
    title: "Антикор",
    subtitle: "днище и полости",
    price: "от 20 000 ₽",
    priceIds: ["price-anticor"],
    ax: 82,
    ay: 72,
    lx: 94,
    ly: 78,
    side: "right" as const,
  },
];

const zoneByPrice: Record<string, string> = {};
for (const z of zones) {
  for (const pid of z.priceIds) zoneByPrice[pid] = z.id;
}

/** Lowest starting price from the live list (полировка фар) */
const fromPrice = "от 3 500 ₽";

function elbowPath(ax: number, ay: number, lx: number, ly: number, side: string): string {
  const mx =
    side === "left" ? Math.min(ax, lx) + Math.abs(ax - lx) * 0.35 : Math.max(ax, lx) - Math.abs(ax - lx) * 0.35;
  const my = side === "top" ? Math.min(ay, ly) + 4 : side === "bottom" ? Math.max(ay, ly) - 4 : (ay + ly) / 2;
  if (side === "top" || side === "bottom") {
    return `M ${ax} ${ay} L ${ax} ${my} L ${lx} ${my} L ${lx} ${ly}`;
  }
  return `M ${ax} ${ay} L ${mx} ${ay} L ${mx} ${ly} L ${lx} ${ly}`;
}
---

<section class="signature" id="signature" aria-labelledby="signature-title" data-signature>
  <div class="signature__head">
    <div class="signature__head-copy">
      <p class="signature__kicker">Услуги</p>
      <h2 id="signature-title" class="signature__title">
        <span class="signature__title-light">Детейлинг</span>
        <span class="signature__title-gold">полный уход</span>
      </h2>
      <p class="signature__lead">
        Нажмите на зону кузова — подсветятся линия, подпись и строки прайса. Реальные услуги и цены
        студии HOLLYWOOD.
      </p>
    </div>
    <p class="signature__badge" aria-label={`Цены стартуют ${fromPrice}`}>
      <span>{fromPrice}</span>
    </p>
  </div>

  <div class="signature__diagram" data-sig-stage>
    <div class="signature__art-wrap">
      <SignatureCarArt />

      <svg
        class="signature__callouts"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        {
          zones.map((z) => (
            <path
              class="signature__line"
              data-sig-line={z.id}
              d={elbowPath(z.ax, z.ay, z.lx, z.ly, z.side)}
              fill="none"
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>

      <ul class="signature__hotspots" data-sig-hotspots>
        {
          zones.map((z) => (
            <li
              class="signature__hot"
              style={`left: ${z.ax}%; top: ${z.ay}%;`}
              data-sig-hot-wrap={z.id}
            >
              <button
                type="button"
                class="signature__dot"
                data-sig-hot={z.id}
                data-price-ids={z.priceIds.join(",")}
                aria-label={`${z.title}, ${z.price}. ${z.subtitle}`}
                aria-controls="prices"
                aria-pressed="false"
              >
                <span class="signature__dot-core" aria-hidden="true" />
                <span class="signature__dot-ring" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>

      <ul class="signature__labels" aria-hidden="true">
        {
          zones.map((z) => (
            <li
              class={`signature__label signature__label--${z.side}`}
              style={`left: ${z.lx}%; top: ${z.ly}%;`}
              data-sig-label={z.id}
            >
              <span class="signature__label-title">{z.title}</span>
              <span class="signature__label-sub">{z.subtitle}</span>
              <span class="signature__label-price">{z.price}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="signature__prices" id="prices" data-sig-prices>
    <div class="signature__prices-head">
      <p class="signature__panel-kicker">Прайс</p>
      <h3 class="signature__prices-title">Цены</h3>
      <p class="signature__prices-lead">
        Стартовые цены с Яндекс Карт. Выберите зону на схеме — строки подсветятся.
      </p>
    </div>
    <ul class="signature__price-list" data-sig-price-list>
      {
        prices.map((row) => (
          <li
            class="price-list__row"
            id={row.id}
            data-sig-price-row={row.id}
            data-zone={zoneByPrice[row.id] ?? ""}
            tabindex="0"
          >
            <span class="price-list__name">{row.title}</span>
            <span class="price-list__sum">{row.price}</span>
          </li>
        ))
      }
    </ul>
    <div class="signature__prices-cta">
      <p>Нужна другая услуга — напишите, подскажем по авто.</p>
      <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
        >Уточнить в WhatsApp</a
      >
    </div>
  </div>

  <p class="signature__note">Цены — из карточки на Яндекс Картах. Итоговая сумма после осмотра авто.</p>
</section>

<script>
  import { initSignatureViewer } from "../scripts/signature-viewer";

  const root = document.querySelector("[data-signature]");
  if (root instanceof HTMLElement) initSignatureViewer(root);
</script>
