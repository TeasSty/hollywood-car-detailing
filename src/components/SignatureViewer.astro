---
interface PriceRow {
  id: string;
  title: string;
  price: string;
}

interface Props {
  prices: PriceRow[];
  waHref: string;
  modelUrl: string;
}

const { prices, waHref, modelUrl } = Astro.props;

/**
 * One hotspot → one unique price row (no multi-row repeats).
 * Anchors are local-space points on the fitted CarConcept model (¾ front-right bias).
 */
const zones = [
  {
    id: "optics",
    title: "Оптика",
    subtitle: "Bi-LED линзы",
    price: "от 12 000 ₽",
    priceId: "price-biled",
    point: [0.72, 0.12, 1.05],
    side: "left" as const,
    labelBias: [-16, 14],
  },
  {
    id: "ppf",
    title: "Плёнка",
    subtitle: "капот и бампер",
    price: "от 12 000 ₽",
    priceId: "price-ppf",
    point: [0.15, 0.38, 0.95],
    side: "left" as const,
    labelBias: [-18, -16],
  },
  {
    id: "paint",
    title: "Полировка",
    subtitle: "кузов / ЛКП",
    price: "от 14 000 ₽",
    priceId: "price-polish",
    point: [0.05, 0.55, 0.1],
    side: "top" as const,
    labelBias: [0, -18],
  },
  {
    id: "ceramic",
    title: "Керамика",
    subtitle: "защитный слой",
    price: "от 18 900 ₽",
    priceId: "price-ceramic",
    point: [-0.55, 0.42, -0.15],
    side: "right" as const,
    labelBias: [18, -10],
  },
  {
    id: "glass",
    title: "Стёкла",
    subtitle: "жидкое стекло",
    price: "от 5 000 ₽",
    priceId: "price-glasscoat",
    point: [0.2, 0.48, 0.35],
    side: "right" as const,
    labelBias: [20, -2],
  },
  {
    id: "interior",
    title: "Салон",
    subtitle: "химчистка",
    price: "уточняйте",
    priceId: "price-interior",
    point: [0.35, 0.28, 0.15],
    side: "right" as const,
    labelBias: [14, 12],
  },
  {
    id: "wheels",
    title: "Колёса",
    subtitle: "шумка арок",
    price: "от 6 000 ₽",
    priceId: "price-noise",
    point: [0.85, -0.35, 0.55],
    side: "bottom" as const,
    labelBias: [4, 16],
  },
  {
    id: "rear",
    title: "Зад / антикор",
    subtitle: "днище и полости",
    price: "от 20 000 ₽",
    priceId: "price-anticor",
    point: [-0.2, -0.25, -1.05],
    side: "right" as const,
    labelBias: [16, 18],
  },
];

const zonePriceIds = new Set(zones.map((z) => z.priceId));
/** Deduped list: zone-linked rows first (unique), then remaining services once */
const seen = new Set<string>();
const uniquePrices: PriceRow[] = [];
for (const row of prices) {
  if (seen.has(row.id)) continue;
  seen.add(row.id);
  uniquePrices.push(row);
}
const orderedPrices = [
  ...uniquePrices.filter((r) => zonePriceIds.has(r.id)),
  ...uniquePrices.filter((r) => !zonePriceIds.has(r.id)),
];

const zoneByPrice: Record<string, string> = {};
for (const z of zones) zoneByPrice[z.priceId] = z.id;

const fromPrice = "от 3 500 ₽";
const zonesJson = JSON.stringify(zones);
---

<section class="signature" id="signature" aria-labelledby="signature-title" data-signature data-sig-3d data-model-url={modelUrl}>
  <div class="signature__head">
    <div class="signature__head-copy">
      <p class="signature__kicker">Услуги</p>
      <h2 id="signature-title" class="signature__title">
        <span class="signature__title-light">Детейлинг</span>
        <span class="signature__title-gold">полный уход</span>
      </h2>
      <p class="signature__lead">
        3D-схема кузова: нажмите зону — подсветятся линия, подпись и строка прайса. Реальные услуги
        студии HOLLYWOOD.
      </p>
    </div>
    <p class="signature__badge" aria-label={`Цены стартуют ${fromPrice}`}>
      <span>{fromPrice}</span>
    </p>
  </div>

  <div class="signature__diagram" data-sig-stage>
    <div class="signature__art-wrap signature__art-wrap--3d">
      <div class="signature__canvas-host" data-sig-canvas></div>

      <svg
        class="signature__callouts"
        data-sig-callouts
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"></svg>

      <ul class="signature__hotspots" data-sig-hotspots></ul>
      <ul class="signature__labels" data-sig-labels aria-hidden="true"></ul>
    </div>
  </div>

  <p class="signature__credit">
    3D: CarConcept —
    <a href="https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/CarConcept" target="_blank" rel="noopener noreferrer">Khronos glTF Sample Assets</a>
    (исходник Unity Fan, CC0; сборка Khronos). Wireframe / studio look — HOLLYWOOD site.
  </p>

  <div class="signature__prices" id="prices" data-sig-prices>
    <div class="signature__prices-head">
      <p class="signature__panel-kicker">Прайс</p>
      <h3 class="signature__prices-title">Цены</h3>
      <p class="signature__prices-lead">
        Стартовые цены с Яндекс Карт. Одна услуга — одна строка. Выберите зону на 3D — строка
        подсветится.
      </p>
    </div>
    <ul class="signature__price-list" data-sig-price-list>
      {
        orderedPrices.map((row) => (
          <li
            class="price-list__row"
            id={row.id}
            data-sig-price-row={row.id}
            data-zone={zoneByPrice[row.id] ?? ""}
            tabindex="0"
          >
            <span class="price-list__name">{row.title}</span>
            <span class="price-list__sum">{row.price}</span>
          </li>
        ))
      }
    </ul>
    <div class="signature__prices-cta">
      <p>Нужна другая услуга — напишите, подскажем по авто.</p>
      <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
        >Уточнить в WhatsApp</a
      >
    </div>
  </div>

  <p class="signature__note">Цены — из карточки на Яндекс Картах. Итоговая сумма после осмотра авто.</p>
</section>

<script id="signature-zones-data" type="application/json" is:inline set:html={zonesJson} />
<script>
  import { initSignature3D } from "../scripts/signature-3d";

  const root = document.querySelector("[data-signature]");
  const dataEl = document.getElementById("signature-zones-data");
  if (root instanceof HTMLElement && dataEl?.textContent) {
    const modelUrl = root.dataset.modelUrl || "";
    const zones = JSON.parse(dataEl.textContent);
    initSignature3D(root, zones, modelUrl);
  }
</script>
