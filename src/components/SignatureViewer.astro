---
interface PriceRow {
  id: string;
  title: string;
  price: string;
}

interface Props {
  prices: PriceRow[];
  waHref: string;
  modelUrl: string;
}

const { prices, waHref, modelUrl } = Astro.props;

/**
 * 1 hotspot ↔ 1 unique Hollywood price row.
 * `uvw` = normalized AABB coords on the fitted car:
 *   u 0→1 left→right, v 0→1 bottom→top, w 0→1 rear→front
 * (snaps dots onto body — not free-floating world guesses)
 */
const zones = [
  {
    id: "polish",
    title: "Полировка",
    subtitle: "кузов / ЛКП",
    price: "от 14 000 ₽",
    priceId: "price-polish",
    uvw: [0.52, 0.82, 0.48] as [number, number, number],
    side: "top" as const,
    labelBias: [-2, -14],
  },
  {
    id: "ppf",
    title: "Плёнка",
    subtitle: "капот и бампер",
    price: "от 12 000 ₽",
    priceId: "price-ppf",
    uvw: [0.48, 0.52, 0.88] as [number, number, number],
    side: "left" as const,
    labelBias: [-18, -12],
  },
  {
    id: "ceramic",
    title: "Керамика",
    subtitle: "защитный слой",
    price: "от 18 900 ₽",
    priceId: "price-ceramic",
    uvw: [0.82, 0.58, 0.42] as [number, number, number],
    side: "right" as const,
    labelBias: [16, -10],
  },
  {
    id: "glasscoat",
    title: "Стёкла",
    subtitle: "жидкое стекло",
    price: "от 5 000 ₽",
    priceId: "price-glasscoat",
    uvw: [0.5, 0.74, 0.68] as [number, number, number],
    side: "right" as const,
    labelBias: [14, -16],
  },
  {
    id: "biled",
    title: "Bi-LED",
    subtitle: "линзы",
    price: "от 12 000 ₽",
    priceId: "price-biled",
    uvw: [0.22, 0.4, 0.94] as [number, number, number],
    side: "left" as const,
    labelBias: [-16, 10],
  },
  {
    id: "headlights",
    title: "Фары",
    subtitle: "полировка",
    price: "от 3 500 ₽",
    priceId: "price-headlights",
    uvw: [0.72, 0.4, 0.94] as [number, number, number],
    side: "right" as const,
    labelBias: [14, 8],
  },
  {
    id: "interior",
    title: "Салон",
    subtitle: "химчистка",
    price: "уточняйте",
    priceId: "price-interior",
    uvw: [0.28, 0.56, 0.55] as [number, number, number],
    side: "left" as const,
    labelBias: [-16, 2],
  },
  {
    id: "audio",
    title: "Автозвук",
    subtitle: "магнитола",
    price: "от 6 000 ₽",
    priceId: "price-audio",
    uvw: [0.42, 0.5, 0.62] as [number, number, number],
    side: "left" as const,
    labelBias: [-14, 16],
  },
  {
    id: "noise",
    title: "Шумка",
    subtitle: "арки / двери",
    price: "от 6 000 ₽",
    priceId: "price-noise",
    uvw: [0.12, 0.22, 0.7] as [number, number, number],
    side: "bottom" as const,
    labelBias: [-10, 12],
  },
  {
    id: "retrim",
    title: "Перетяжка",
    subtitle: "салон",
    price: "от 15 000 ₽",
    priceId: "price-retrim",
    uvw: [0.55, 0.54, 0.4] as [number, number, number],
    side: "right" as const,
    labelBias: [18, 4],
  },
  {
    id: "anticor",
    title: "Антикор",
    subtitle: "днище",
    price: "от 20 000 ₽",
    priceId: "price-anticor",
    uvw: [0.5, 0.12, 0.18] as [number, number, number],
    side: "bottom" as const,
    labelBias: [12, 14],
  },
  {
    id: "ambient",
    title: "Подсветка",
    subtitle: "контур",
    price: "от 15 000 ₽",
    priceId: "price-ambient",
    uvw: [0.2, 0.48, 0.38] as [number, number, number],
    side: "left" as const,
    labelBias: [-18, -6],
  },
  {
    id: "alarm",
    title: "Сигналка",
    subtitle: "охрана",
    price: "от 11 000 ₽",
    priceId: "price-alarm",
    uvw: [0.48, 0.6, 0.78] as [number, number, number],
    side: "top" as const,
    labelBias: [10, -12],
  },
  {
    id: "custom",
    title: "Кастом",
    subtitle: "допы",
    price: "уточняйте",
    priceId: "price-custom",
    uvw: [0.58, 0.62, 0.12] as [number, number, number],
    side: "right" as const,
    labelBias: [16, 14],
  },
];

const zonePriceIds = new Set(zones.map((z) => z.priceId));
const seen = new Set<string>();
const uniquePrices: PriceRow[] = [];
for (const row of prices) {
  if (seen.has(row.id)) continue;
  seen.add(row.id);
  uniquePrices.push(row);
}
/** Every listed Hollywood price must have a zone; keep list order from prices */
const orderedPrices = uniquePrices.filter((r) => zonePriceIds.has(r.id));
const missing = uniquePrices.filter((r) => !zonePriceIds.has(r.id));
if (missing.length) {
  console.warn(
    "[SignatureViewer] prices without hotspot:",
    missing.map((m) => m.id).join(", "),
  );
}

const zoneByPrice: Record<string, string> = {};
for (const z of zones) zoneByPrice[z.priceId] = z.id;

const fromPrice = "от 3 500 ₽";
const zonesJson = JSON.stringify(zones);
---

<section
  class="signature"
  id="signature"
  aria-labelledby="signature-title"
  data-signature
  data-sig-3d
  data-model-url={modelUrl}
>
  <div class="signature__head">
    <div class="signature__head-copy">
      <p class="signature__kicker">Услуги</p>
      <h2 id="signature-title" class="signature__title">
        <span class="signature__title-light">Детейлинг</span>
        <span class="signature__title-gold">полный уход</span>
      </h2>
      <p class="signature__lead">
        3D-схема кузова: нажмите зону — подсветятся линия, подпись и строка прайса. Реальные услуги
        студии HOLLYWOOD.
      </p>
    </div>
    <p class="signature__badge" aria-label={`Цены стартуют ${fromPrice}`}>
      <span>{fromPrice}</span>
    </p>
  </div>

  <div class="signature__diagram" data-sig-stage>
    <div class="signature__art-wrap signature__art-wrap--3d">
      <div class="signature__canvas-host" data-sig-canvas></div>

      <svg
        class="signature__callouts"
        data-sig-callouts
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"></svg>

      <ul class="signature__hotspots" data-sig-hotspots></ul>
      <ul class="signature__labels" data-sig-labels aria-hidden="true"></ul>
    </div>
  </div>

  <p class="signature__credit">
    3D: CarConcept —
    <a
      href="https://github.com/KhronosGroup/glTF-Sample-Assets/tree/main/Models/CarConcept"
      target="_blank"
      rel="noopener noreferrer">Khronos glTF Sample Assets</a
    >
    (исходник Unity Fan, CC0; сборка Khronos). Wireframe / studio look — HOLLYWOOD site.
  </p>

  <div class="signature__prices" id="prices" data-sig-prices>
    <div class="signature__prices-head">
      <p class="signature__panel-kicker">Прайс</p>
      <h3 class="signature__prices-title">Цены</h3>
      <p class="signature__prices-lead">
        Стартовые цены с Яндекс Карт. Одна услуга — одна точка на схеме и одна строка.
      </p>
    </div>
    <ul class="signature__price-list" data-sig-price-list>
      {
        orderedPrices.map((row) => (
          <li
            class="price-list__row"
            id={row.id}
            data-sig-price-row={row.id}
            data-zone={zoneByPrice[row.id] ?? ""}
            tabindex="0"
          >
            <span class="price-list__name">{row.title}</span>
            <span class="price-list__sum">{row.price}</span>
          </li>
        ))
      }
    </ul>
    <div class="signature__prices-cta">
      <p>Нужна другая услуга — напишите, подскажем по авто.</p>
      <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
        >Уточнить в WhatsApp</a
      >
    </div>
  </div>

  <p class="signature__note">Цены — из карточки на Яндекс Картах. Итоговая сумма после осмотра авто.</p>
</section>

<script id="signature-zones-data" type="application/json" is:inline set:html={zonesJson} />
<script>
  import { initSignature3D } from "../scripts/signature-3d";

  const root = document.querySelector("[data-signature]");
  const dataEl = document.getElementById("signature-zones-data");
  if (root instanceof HTMLElement && dataEl?.textContent) {
    const modelUrl = root.dataset.modelUrl || "";
    const zones = JSON.parse(dataEl.textContent);
    initSignature3D(root, zones, modelUrl);
  }
</script>
