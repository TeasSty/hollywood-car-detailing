---
/**
 * Interactive Signature Viewer — side-profile sports sedan.
 * Original SVG traced to BMW M5 Competition (F90) side proportions:
 * long hood, Hofmeister kink, aggressive bumper, large wheel arches.
 * No BMW roundel / trademark lettering — kidney silhouette shape only.
 * Artwork: original for this site (all rights reserved for the SVG).
 */

interface PriceRow {
  id: string;
  title: string;
  price: string;
}

interface Props {
  prices: PriceRow[];
  waHref: string;
}

const { prices, waHref } = Astro.props;

const zones = [
  {
    id: "optics",
    label: "Оптика",
    title: "Bi-LED линзы и полировка фар",
    price: "от 12 000 ₽",
    detail: "Bi-LED от 12 000 ₽ · полировка фар от 3 500 ₽",
    priceIds: ["price-biled", "price-headlights"],
    x: 10.5,
    y: 54,
    side: "top" as const,
  },
  {
    id: "ppf",
    label: "Защита",
    title: "Оклейка бронеплёнкой",
    price: "от 12 000 ₽",
    detail: "Капот, бампер, крылья, зоны риска сколов",
    priceIds: ["price-ppf"],
    x: 22,
    y: 38,
    side: "top" as const,
  },
  {
    id: "paint",
    label: "Кузов",
    title: "Полировка кузова",
    price: "от 14 000 ₽",
    detail: "Лёгкая и глубокая — глубина цвета и блеск ЛКП",
    priceIds: ["price-polish"],
    x: 44,
    y: 28,
    side: "top" as const,
  },
  {
    id: "ceramic",
    label: "Керамика",
    title: "Керамика и жидкое стекло",
    price: "от 18 900 ₽",
    detail: "Керамика от 18 900 ₽ · жидкое стекло от 5 000 ₽",
    priceIds: ["price-ceramic", "price-glasscoat"],
    x: 64,
    y: 30,
    side: "top" as const,
  },
  {
    id: "interior",
    label: "Салон",
    title: "Химчистка салона",
    price: "уточняйте",
    detail: "Глубокая чистка — объём после осмотра",
    priceIds: ["price-interior"],
    x: 48,
    y: 46,
    side: "bottom" as const,
  },
  {
    id: "sound",
    label: "Звук",
    title: "Автозвук / магнитола",
    price: "от 6 000 ₽",
    detail: "От замены магнитолы до соревновательного уровня",
    priceIds: ["price-audio"],
    x: 36,
    y: 54,
    side: "bottom" as const,
  },
  {
    id: "noise",
    label: "Шумоизоляция",
    title: "Шумоизоляция",
    price: "от 6 000 ₽",
    detail: "Двери, пол, арки — тише в салоне",
    priceIds: ["price-noise"],
    x: 70,
    y: 54,
    side: "bottom" as const,
  },
  {
    id: "rear",
    label: "Антикор",
    title: "Антикор",
    price: "от 20 000 ₽",
    detail: "Обработка днища и скрытых полостей",
    priceIds: ["price-anticor"],
    x: 90,
    y: 64,
    side: "bottom" as const,
  },
];

const zoneByPrice: Record<string, string> = {};
for (const z of zones) {
  for (const pid of z.priceIds) zoneByPrice[pid] = z.id;
}
---

<section class="signature" id="signature" aria-labelledby="signature-title" data-signature>
  <div class="section-head">
    <p class="kicker">Зоны авто</p>
    <h2 id="signature-title">Что можно сделать с авто</h2>
    <p>
      Наведите на зону кузова — прайс справа подсветит и прокрутит нужную строку. Силуэт
      спортивного седана по пропорциям M5 Competition (F90).
    </p>
  </div>

  <div class="signature__wrap">
    <div class="signature__stage" data-sig-stage>
      <svg
        class="signature__svg"
        viewBox="0 0 1280 460"
        role="img"
        aria-label="Боковой силуэт спортивного седана в пропорциях BMW M5 Competition"
        data-sig-svg
