            <stop offset="100%" stop-color="#f4f1ea" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="sig-glass" x1="0%" y1="0%" x2="20%" y2="100%">
            <stop offset="0%" stop-color="#9aadb8" stop-opacity="0.42" />
            <stop offset="55%" stop-color="#4a5560" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#2a3238" stop-opacity="0.18" />
          </linearGradient>
          <linearGradient id="sig-ground" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#c8102e" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#c8102e" stop-opacity="0" />
          </linearGradient>
        </defs>

        <ellipse class="signature__ground" cx="640" cy="412" rx="500" ry="14" fill="url(#sig-ground)" />

        <!-- Body fill — F90-inspired sports sedan proportions -->
