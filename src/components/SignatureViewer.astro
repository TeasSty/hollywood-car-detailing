        <defs>
          <linearGradient id="sig-body" x1="8%" y1="20%" x2="92%" y2="90%">
            <stop offset="0%" stop-color="#2e2e34" />
            <stop offset="32%" stop-color="#1c1c22" />
            <stop offset="68%" stop-color="#121216" />
            <stop offset="100%" stop-color="#0a0a0c" />
