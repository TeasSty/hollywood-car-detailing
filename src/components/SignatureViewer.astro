---
interface PriceRow {
  id: string;
  title: string;
  price: string;
}

interface Props {
  prices: PriceRow[];
  waHref: string;
}

const { prices, waHref } = Astro.props;
const modelUrl = `${import.meta.env.BASE_URL}models/car.glb`;

const zones = [
  {
    id: "optics",
    label: "Оптика",
    title: "Bi-LED линзы и полировка фар",
    price: "от 12 000 ₽",
    detail: "Bi-LED от 12 000 ₽ · полировка фар от 3 500 ₽",
    priceIds: ["price-biled", "price-headlights"],
    x: 10.5,
    y: 54,
    side: "top" as const,
  },
  {
    id: "ppf",
    label: "Защита",
    title: "Оклейка бронеплёнкой",
    price: "от 12 000 ₽",
    detail: "Капот, бампер, крылья, зоны риска сколов",
    priceIds: ["price-ppf"],
    x: 22,
    y: 38,
    side: "top" as const,
  },
  {
    id: "paint",
    label: "Кузов",
    title: "Полировка кузова",
    price: "от 14 000 ₽",
    detail: "Лёгкая и глубокая — глубина цвета и блеск ЛКП",
    priceIds: ["price-polish"],
    x: 44,
    y: 28,
    side: "top" as const,
  },
  {
    id: "ceramic",
    label: "Керамика",
    title: "Керамика и жидкое стекло",
    price: "от 18 900 ₽",
    detail: "Керамика от 18 900 ₽ · жидкое стекло от 5 000 ₽",
    priceIds: ["price-ceramic", "price-glasscoat"],
    x: 64,
    y: 30,
    side: "top" as const,
  },
  {
    id: "interior",
    label: "Салон",
    title: "Химчистка салона",
    price: "уточняйте",
    detail: "Глубокая чистка — объём после осмотра",
    priceIds: ["price-interior"],
    x: 48,
    y: 46,
    side: "bottom" as const,
  },
  {
    id: "sound",
    label: "Звук",
    title: "Автозвук / магнитола",
    price: "от 6 000 ₽",
    detail: "От замены магнитолы до соревновательного уровня",
    priceIds: ["price-audio"],
    x: 36,
    y: 54,
    side: "bottom" as const,
  },
  {
    id: "noise",
    label: "Шумоизоляция",
    title: "Шумоизоляция",
    price: "от 6 000 ₽",
    detail: "Двери, пол, арки — тише в салоне",
    priceIds: ["price-noise"],
    x: 70,
    y: 54,
    side: "bottom" as const,
  },
  {
    id: "rear",
    label: "Антикор",
    title: "Антикор",
    price: "от 20 000 ₽",
    detail: "Обработка днища и скрытых полостей",
    priceIds: ["price-anticor"],
    x: 90,
    y: 64,
    side: "bottom" as const,
  },
];

const zoneByPrice: Record<string, string> = {};
for (const z of zones) {
  for (const pid of z.priceIds) zoneByPrice[pid] = z.id;
}
---

<section
  class="signature"
  id="signature"
  aria-labelledby="signature-title"
  data-signature
  data-model-url={modelUrl}
>
  <div class="section-head">
    <p class="kicker">Зоны авто</p>
    <h2 id="signature-title">Что можно сделать с авто</h2>
    <p>
      Наведите на зону кузова — прайс справа подсветит и прокрутит нужную строку. 3D-модель
      спортивного седана в студийном свете.
    </p>
  </div>

  <div class="signature__wrap">
    <div class="signature__stage" data-sig-stage>
      <canvas
        class="signature__canvas"
        data-sig-canvas
        aria-label="3D-модель спортивного седана — зоны услуг детейлинга"
      ></canvas>

      <ul class="signature__hotspots" data-sig-hotspots>
        {
          zones.map((z) => (
            <li class={`signature__hot signature__hot--${z.side}`} style={`--hx:${z.x}%; --hy:${z.y}%;`}>
              <button
                type="button"
                class="signature__dot"
                data-sig-hot={z.id}
                data-price-ids={z.priceIds.join(",")}
                aria-label={`${z.title}, ${z.price}`}
                aria-controls="prices"
                aria-expanded="false"
              >
                <span class="signature__dot-ring" aria-hidden="true" />
                <span class="sr-only">{z.label}</span>
              </button>
              <span class="signature__chip" aria-hidden="true">
                <span class="signature__chip-label">{z.label}</span>
                <span class="signature__chip-price">{z.price}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="signature__prices" id="prices" data-sig-prices aria-label="Прайс услуг">
      <div class="signature__prices-head">
        <p class="signature__panel-kicker">Прайс</p>
        <h3 class="signature__prices-title">Цены</h3>
        <p class="signature__prices-lead">
          Стартовые цены с Яндекс Карт. Наведите зону на авто — строка подсветится.
        </p>
      </div>
      <ul class="signature__price-list" data-sig-price-list>
        {
          prices.map((row) => (
            <li
              class="price-list__row"
              id={row.id}
              data-sig-price-row={row.id}
              data-zone={zoneByPrice[row.id] ?? ""}
              tabindex="0"
            >
              <span class="price-list__name">{row.title}</span>
              <span class="price-list__sum">{row.price}</span>
            </li>
          ))
        }
      </ul>
      <div class="signature__prices-cta">
        <p>Нужна другая услуга — напишите, подскажем по авто.</p>
        <a class="btn btn--solid" href={waHref} target="_blank" rel="noopener noreferrer"
          >Уточнить в WhatsApp</a
        >
      </div>
    </aside>
  </div>

  <p class="signature__note">
    3D-модель: Kenney Car Kit «sedan-sports» (CC0). Цены — из карточки на Яндекс Картах.
  </p>
</section>

<script>
  import { initSignatureViewer } from "../scripts/signature-viewer";

  const root = document.querySelector("[data-signature]");
  if (root instanceof HTMLElement) initSignatureViewer(root);
</script>
