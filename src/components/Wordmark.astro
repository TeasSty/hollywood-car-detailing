---
interface Props {
  href?: string;
  size?: "sm" | "lg";
}

const { href = "#top", size = "sm" } = Astro.props;
---

<a class={`wordmark${size === "lg" ? " wordmark--lg" : ""}`} href={href}>
  <svg
    class="wordmark__palm"
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M11.2 8.6c-1.5-1.7-3.6-2.3-5.6-1.4l-.6-1.5c2.2-1 4.5-.7 6.3.6.2-2.2 1.6-4 3.7-4.7l.6 1.5c-1.9.7-3 2.3-2.9 4.2 1.9-1.3 4.2-1.5 6.2-.4l-.8 1.4c-2-1.1-4.2-.6-5.5 1.1l1.1.5c1 6 1.6 9.4 1.9 12.1h-3c.4-2.9.7-6.6.9-12.4Z"></path>
  </svg>
  <span class="wordmark__stack">
    <span class="wordmark__main">HOLLYWOOD</span>
    <span class="wordmark__script">car detailing</span>
  </span>
</a>
